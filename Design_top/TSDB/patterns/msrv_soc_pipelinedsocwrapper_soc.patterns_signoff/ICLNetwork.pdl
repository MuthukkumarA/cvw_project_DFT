iProcsForModule msrv_soc_pipelinedsocwrapper

iProc msrv_soc_pipelinedsocwrapper {} {

   iReset
   iNote "Activate selection for scan mux msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib, load value = 1"
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib 0b1
   iRead  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb1_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb2_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb3_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb3_inst.sib, load value = 1"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb2_inst.sib, load value = 1"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb1_inst.sib, load value = 0"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib, load value = 1"
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb3_inst.sib 0b1
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb2_inst.sib 0b1
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb1_inst.sib 0b0
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib 0b1
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb3_inst.sib, expected value = 1"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb2_inst.sib, expected value = 1"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb1_inst.sib, expected value = 0"
   iNote "  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb3_inst.sib 0b0
   iRead  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb3_inst.sib 0b1
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb2_inst.sib 0b0
   iRead  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb2_inst.sib 0b1
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb1_inst.sib 0b0
   iRead  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_pb1_inst.sib 0b0
   iWrite msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib 0b0
   iRead  msrv_soc_pipelinedsocwrapper_soc_tessent_sib_sri_inst.sib 0b1
   iApply


}
