        }
        Sib(pb1) {
          DesignInstance(dut/core_dft) {
            scan_interface : ijtag;
          }
        }
        Sib(pb2) {
          DesignInstance(dut/sys_ctrl) {
            scan_interface : ijtag;
          }
        }
        Sib(pb3) {
          DesignInstance(dut/uncore_dft) {
