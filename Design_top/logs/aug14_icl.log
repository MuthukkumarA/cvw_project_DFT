              [ -type { data_in | data_out | scan_in | scan_out | clock | to_clock | reset | to_reset | reset_n | to_reset_n | tck | to_tck | tms | to_tms | trst | to_trst | capture_en | to_capture_en | shift_en | to_shift_en | update_en | to_update_en | select | to_select | address | write_en | read_en | ir_select | to_ir_select } ] 
              [ -function_modifier <modifier> ] 
              [ -source <source_port> [ -inverted ] | -trace ] 
              [ -forced_low_dft_signal_list <forced_low_dft_signals> ] [ -forced_high_dft_signal_list <forced_high_dft_signals> ] 
              [ -attributes <attribute_and_value_list> ] 
//  command: exit 
