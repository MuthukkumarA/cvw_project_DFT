//
// NOTE: Internal control signals were specified during
// scan insertion.  Procedure statements which contain
// these internal control signals may require editing to
// make the corresponding procedure functional.
set time scale 1.000000 ns ;
set strobe_window time 10 ; 

 timeplate gen_tp1 =
    force_pi 0 ; 
    measure_po 10 ; 
    pulse_clock 20 10 ; 
    pulse clk 20 10;
    pulse ijtag_tck 20 10;
    pulse inferred_occ_clock0 20 10;
    pulse test_clock_w 20 10;
    period 40 ; 
 end;

 procedure shift =
    scan_group grp1 ;
    timeplate gen_tp1 ;
    // cycle 0 starts at time 0
    cycle =
        force_sci ;
        measure_sco ;
        pulse ijtag_tck ;
        pulse inferred_occ_clock0 ;
        pulse test_clock_w ;
    end;
 end;

 procedure test_setup =
    timeplate gen_tp1 ;
    // cycle 0 starts at time 0
    cycle =
        force edt_update 0 ;
        force ijtag_reset 1 ;
        force ijtag_sel 0 ;
        force ijtag_tck 0 ;
        force msrv_soc_pipelinedcorewrapper_pass1_rtl_tessent_tdr_sri_ctrl_inst/ltest_en 1 ;
        force scan_en_w 0 ;
    end ;
    iReset;
    iCall dft_signal_iproc msrv_soc_pipelinedcorewrapper_pass1_rtl_tessent_tdr_sri_ctrl_inst.ltest_en 1;
    // cycle 24 starts at time 960
    cycle =
        force edt_update 0 ;
    end ;
    // cycle 25 starts at time 1000
    cycle =
        force ijtag_tck 0 ;
    end;
 end;

 procedure load_unload =
    scan_group grp1 ;
    timeplate gen_tp1 ;
    // cycle 0 starts at time 0
    cycle =
        force clk 0 ;
        force edt_update 0 ;
        force ijtag_ce 0 ;
        force ijtag_reset 1 ;
        force ijtag_se 0 ;
        force ijtag_sel 0 ;
        force ijtag_si 0 ;
        force ijtag_tck 0 ;
        force ijtag_ue 0 ;
        force inferred_occ_clock0 0 ;
        force msrv_soc_pipelinedcorewrapper_pass1_rtl_tessent_tdr_sri_ctrl_inst/ltest_en 1 ;
        force scan_en_w 1 ;
        force test_clock_w 0 ;
    end ;
    apply shift 455;
 end;

