          Tdr(sri_ctrl) {
            Attributes {
              tessent_dft_function : scan_resource_instrument_dft_control;
            }
          }
        }
        Sib(edt) {
        }
        Sib(occ) {
        }
        Sib(lbist) {
        }
      }
    }
  }
}
//  command: #OCC specification given by sir.
//  command: read_config_data -in $spec -from_string { OCC { ijtag_host_interface : Sib(occ); static_clock_control : both; capture_trigger : capture_en; }}
//  command: set id_clk_list [list clk clk]
//  command: foreach {id clk} $id_clk_list {
//            set occ [add_config_element OCC/controller($id) -in $spec]
//            set_config_value clock_intercept_node -in $occ $clk
//           }
//  sub-command: add_config_element OCC/controller(clk) -in /DftSpecification(msrv_soc_system_controllerwrapper,sys_controller) 
//  sub-command: set_config_value clock_intercept_node -in {/DftSpecification(msrv_soc_system_controllerwrapper,sys_controller)/OCC/Controller(clk)} clk 
//  command: #EDT specification given by the sir.
//  command: read_config_data -in $spec -from_string {
  EDT {
    ijtag_host_interface : Sib(edt);
    Controller (c1) {
      longest_chain_range : 50, 65;
      scan_chain_count : 60;
      input_channel_count : 2;
      output_channel_count : 2;
        LogicBistOptions { 
          misr_input_ratio : 1 ;
          ShiftPowerOptions {
            present : on ;
            default_operation : disabled ;
            SwitchingThresholdPercentage {
              hardware_default : 25 ;
           }
         }
       }
    }
  }
}
//  command: report_config_data $spec

DftSpecification(msrv_soc_system_controllerwrapper,sys_controller) {
  IjtagNetwork {
    HostScanInterface(ijtag) {
      Sib(sri) {
        Attributes {
          tessent_dft_function : scan_resource_instrument_host;
        }
        Sib(sri_ctrl) {
          Tdr(sri_ctrl) {
            Attributes {
              tessent_dft_function : scan_resource_instrument_dft_control;
            }
          }
        }
        Sib(edt) {
        }
        Sib(occ) {
        }
        Sib(lbist) {
        }
      }
    }
  }
  OCC {
    ijtag_host_interface : Sib(occ);
    static_clock_control : both;
    capture_trigger : capture_en;
    Controller(clk) {
      clock_intercept_nodes : clk;
    }
  }
  EDT {
    ijtag_host_interface : Sib(edt);
    Controller(c1) {
      longest_chain_range : 50, 65;
      scan_chain_count : 60;
      input_channel_count : 2;
      output_channel_count : 2;
      LogicBistOptions {
        misr_input_ratio : 1;
        ShiftPowerOptions {
          present : on;
          default_operation : disabled;
          SwitchingThresholdPercentage {
            hardware_default : 25;
          }
        }
      }
    }
  }
}
//  command: #LBIST specification given by the sir.
//  command: read_config_data -in $spec -from_string {
  LogicBist {
    ijtag_host_interface : Sib(lbist);
    Controller(1%ctrl_lbist) {
      burn_in : on ;
      pre_post_shift_dead_cycles : 8 ;
      SingleChainForDiagnosis {
        Present : on ;
      }  
      ControllerChain {
         present : on; 
         clock : tck;
      }
      Connections {
        shift_clock_src:lbist_shift_clk;
      }

      NcpOptions {
        count : 1;
      }
  
      ShiftCycles { max :800 ; }   
      CaptureCycles { max : 7; }   
      PatternCount { max : 1024; }   
      WarmupPatternCount { max : 128; }   
    }
  
   }
}
//  command: report_config_data $spec

DftSpecification(msrv_soc_system_controllerwrapper,sys_controller) {
  IjtagNetwork {
    HostScanInterface(ijtag) {
      Sib(sri) {
        Attributes {
          tessent_dft_function : scan_resource_instrument_host;
        }
        Sib(sri_ctrl) {
          Tdr(sri_ctrl) {
            Attributes {
              tessent_dft_function : scan_resource_instrument_dft_control;
            }
          }
        }
        Sib(edt) {
        }
        Sib(occ) {
        }
        Sib(lbist) {
        }
      }
    }
  }
  OCC {
    ijtag_host_interface : Sib(occ);
    static_clock_control : both;
    capture_trigger : capture_en;
    Controller(clk) {
      clock_intercept_nodes : clk;
    }
  }
  EDT {
    ijtag_host_interface : Sib(edt);
    Controller(c1) {
      longest_chain_range : 50, 65;
      scan_chain_count : 60;
      input_channel_count : 2;
      output_channel_count : 2;
      LogicBistOptions {
        misr_input_ratio : 1;
        ShiftPowerOptions {
          present : on;
          default_operation : disabled;
          SwitchingThresholdPercentage {
            hardware_default : 25;
          }
        }
      }
    }
  }
  LogicBist {
    ijtag_host_interface : Sib(lbist);
    Controller(1%ctrl_lbist) {
      burn_in : on;
      pre_post_shift_dead_cycles : 8;
      SingleChainForDiagnosis {
        present : on;
      }
      ControllerChain {
        present : on;
        clock : tck;
      }
      Connections {
        shift_clock_src : lbist_shift_clk;
      }
      NcpOptions {
        count : 1;
      }
      ShiftCycles {
        max : 800;
      }
      CaptureCycles {
        max : 7;
      }
      PatternCount {
        max : 1024;
      }
      WarmupPatternCount {
        max : 128;
      }
    }
  }
}
