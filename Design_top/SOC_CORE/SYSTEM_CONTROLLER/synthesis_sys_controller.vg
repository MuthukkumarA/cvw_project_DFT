module msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_sib(ijtag_reset, 
                                                                          ijtag_sel, 
                                                                          ijtag_si, 
                                                                          ijtag_ce, 
                                                                          ijtag_se, 
                                                                          ijtag_ue, 
                                                                          ijtag_tck, 
                                                                          ccm_scan_en, 
                                                                          ccm_te_si, 
                                                                          ccm_te_so, 
                                                                          ijtag_so, 
                                                                          ijtag_from_so, 
                                                                          ijtag_to_sel);
  input  ijtag_reset, ijtag_sel, ijtag_si, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_tck, ccm_scan_en, ccm_te_si, ijtag_from_so;
  output ccm_te_so, ijtag_so, ijtag_to_sel;

  wire sib, sib_latch, so_retime, to_enable_int, rtlcClkX, rtlcXXX, 
       rtlc2_sib_latch_SS2_n4, rtlc2n21, rtlc2_neg_clk_n43, rtlc5n14, 
       rtlc8_sib_SS1_n3, rtlc8_sib_SS3_n5, rtlc8_sib_SS4_n6, rtlc8n25, 
       rtlc8n32, rtlc9n7, rtlcn63, rtlcn64, rtlcn65, rtlcn66, rtlcn67;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_INV rtlc2_4(
      .Z(rtlc2_neg_clk_n43), .A(ijtag_tck)
  );
  RTLC_AND2 rtlc2_16(
      .Z(rtlc2n21), .A(ijtag_ue), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc5_0(
      .Z(rtlc5n14), .in_1(to_enable_int), .in_0(sib), .sel_0(ccm_scan_en)
  );
  RTLC_AND2 rtlc8_24(
      .Z(rtlc8n32), .A(ijtag_se), .B(ijtag_sel)
  );
  RTLC_AND2 rtlc8_29(
      .Z(rtlc8n25), .A(ijtag_ce), .B(ijtag_sel)
  );
  RTLC_BUF rtlc9_2(
      .Z(ccm_te_so), .A(so_retime)
  );
  RTLC_AND2 rtlc9_4(
      .Z(rtlc9n7), .A(to_enable_int), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc9_5(
      .Z(ijtag_so), .in_1(sib), .in_0(so_retime), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc_53(
      .Z(rtlc2_sib_latch_SS2_n4), .in_1(ccm_te_si), .in_0(sib), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc_54(
      .Z(rtlc8_sib_SS1_n3), .in_1(ijtag_from_so), .in_0(ijtag_si), .sel_0(sib_latch)
  );
  M_RTLSIM_MUXN_2_1 rtlc_56(
      .Z(rtlc8_sib_SS4_n6), .in_1(ijtag_from_so), .in_0(rtlc8_sib_SS3_n5), .sel_0(ccm_scan_en)
  );
  RTLC_INV rtlc_57(
      .Z(rtlcn66), .A(rtlc8n25)
  );
  RTLC_AND2 rtlc_58(
      .Z(rtlc8_sib_SS3_n5), .A(rtlc8_sib_SS1_n3), .B(rtlcn66)
  );
  RTLC_INV rtlc_59(
      .Z(rtlcn67), .A(ijtag_reset)
  );
  RTLC_OR2 rtlc_70(
      .Z(rtlcn64), .A(rtlc8n32), .B(rtlc8n25)
  );
  RTLC_OR2 rtlc_71(
      .Z(rtlcn65), .A(rtlcn64), .B(ccm_scan_en)
  );
  RTLC_OR2 rtlc_72(
      .Z(rtlcn63), .A(rtlc2n21), .B(ccm_scan_en)
  );
  RTLC_OR2 rtlc_73(
      .Z(ijtag_to_sel), .A(rtlc9n7), .B(ccm_scan_en)
  );
  RTLC_FDCE rtlcreg_sib_latch(
      .Q(sib_latch), .D(rtlc2_sib_latch_SS2_n4), .CP(rtlc2_neg_clk_n43), .CLR(rtlcn67), 
      .CE(rtlcn63)
  );
  RTLC_FDC rtlcreg_to_enable_int(
      .Q(to_enable_int), .D(sib_latch), .CP(rtlc2_neg_clk_n43), .CLR(rtlcn67)
  );
  RTLC_FDC rtlcreg_so_retime(
      .Q(so_retime), .D(rtlc5n14), .CP(rtlc2_neg_clk_n43), .CLR(rtlcn67)
  );
  RTLC_FDCE rtlcreg_sib(
      .Q(sib), .D(rtlc8_sib_SS4_n6), .CP(ijtag_tck), .CLR(rtlcn67), .CE(rtlcn65)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_ctrl(lbist_clock, 
                                                                           lbist_en, 
                                                                           ccm_scan_en, 
                                                                           ccm_le_si, 
                                                                           ccm_le_so, 
                                                                           ccm_te_si, 
                                                                           ccm_te_so, 
                                                                           capture_phase_size, 
                                                                           lbist_scan_in, 
                                                                           lbist_scan_out, 
                                                                           shift_phase, 
                                                                           lbist_reset, 
                                                                           lbist_run_mode, 
                                                                           lbist_burn_in, 
                                                                           prpg_en, 
                                                                           warmup_done, 
                                                                           last_bit, 
                                                                           last_vector, 
                                                                           ijtag_tck, 
                                                                           ijtag_reset, 
                                                                           ijtag_sel, 
                                                                           ijtag_ce, 
                                                                           ijtag_se, 
                                                                           ijtag_ue);
  input  lbist_clock, lbist_en, ccm_scan_en, ccm_le_si, ccm_te_si, 
         lbist_scan_in, shift_phase, lbist_reset, lbist_run_mode, 
         lbist_burn_in, prpg_en, ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, 
         ijtag_se, ijtag_ue;
  output [2:0] capture_phase_size;
  output ccm_le_so, ccm_te_so, lbist_scan_out, warmup_done, last_bit, 
         last_vector;

  wire [7:0] warmup_pattern_cnt, vector_cnt_lsb;
  wire counter_bist_scan_out_retime, lbist_scan_en_int, capture_phase_size_so, 
       warmup_pattern_cnt_so, counter_bist_scan_out, last_vector_int, 
       sib_to_enable, ccm_te_so_lbist_sib, lbist_sib_ijtag_from_so, 
       lbist_scan_in_int, lbist_counter_ccm_le_so, rtlcClkX, rtlcXXX, rtlc2n12, 
       rtlc2_neg_clk_n16, rtlc3n13, rtlc3n14, rtlcn25;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_capture_phase_reg msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_capture_phase_size_reg_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(lbist_scan_en_int), .lbist_reset(lbist_reset), 
      .reset(ijtag_reset), .scan_in(lbist_scan_in_int), .scan_out(capture_phase_size_so), 
      .capture_phase_size(capture_phase_size)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_warmup_pattern_cnt_reg msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_warmup_pattern_cnt_reg_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(lbist_scan_en_int), .lbist_reset(lbist_reset), 
      .reset(ijtag_reset), .scan_in(capture_phase_size_so), .scan_out(warmup_pattern_cnt_so), 
      .warmup_pattern_cnt(warmup_pattern_cnt)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_counter msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_counter_i(
      .lbist_clock(lbist_clock), .lbist_scan_en(lbist_scan_en_int), .lbist_run_mode(lbist_run_mode), 
      .reset(ijtag_reset), .ccm_scan_en(ccm_scan_en), .ccm_le_si(warmup_pattern_cnt_so), 
      .ccm_le_so(lbist_counter_ccm_le_so), .shift_phase(shift_phase), .prpg_en(prpg_en), 
      .lbist_burn_in(lbist_burn_in), .lbist_reset(lbist_reset), .lbist_scan_in(warmup_pattern_cnt_so), 
      .lbist_scan_out(counter_bist_scan_out), .last_bit(last_bit), .vector_cnt_lsb(vector_cnt_lsb), 
      .last_vector(last_vector_int)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_sib msrv_soc_system_controllerwrapper_sys_controller_tessent_lbist_sib_i(
      .ijtag_reset(ijtag_reset), .ijtag_sel(ijtag_sel), .ijtag_si(lbist_scan_in), 
      .ijtag_ce(ijtag_ce), .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_tck(ijtag_tck), 
      .ccm_scan_en(ccm_scan_en), .ccm_te_si(counter_bist_scan_out_retime), .ccm_te_so(ccm_te_so_lbist_sib), 
      .ijtag_so(lbist_scan_out), .ijtag_from_so(lbist_sib_ijtag_from_so), .ijtag_to_sel(sib_to_enable)
  );
  M_RTLSIM_MUXN_2_1 rtlc2_0(
      .Z(rtlc2n12), .in_1(ccm_te_si), .in_0(counter_bist_scan_out), .sel_0(ccm_scan_en)
  );
  RTLC_INV rtlc2_2(
      .Z(rtlc2_neg_clk_n16), .A(ijtag_tck)
  );
  RTLC_BUF rtlc3_2(
      .Z(last_vector), .A(last_vector_int)
  );
  RTLC_BUF rtlc3_5(
      .Z(ccm_le_so), .A(lbist_scan_out)
  );
  RTLC_BUF rtlc3_6(
      .Z(ccm_te_so), .A(ccm_te_so_lbist_sib)
  );
  M_RTLSIM_MUXN_2_1 rtlc3_7(
      .Z(lbist_scan_in_int), .in_1(ccm_le_si), .in_0(lbist_scan_in), .sel_0(ccm_scan_en)
  );
  RTLC_AND2 rtlc3_9(
      .Z(rtlc3n14), .A(rtlc3n13), .B(sib_to_enable)
  );
  RTLC_AND2 rtlc3_10(
      .Z(rtlc3n13), .A(lbist_en), .B(ijtag_se)
  );
  M_RTLSIM_EQ_8 rtlc3_11(
      .Z(warmup_done), .in1_7(vector_cnt_lsb[7]), .in1_6(vector_cnt_lsb[6]), .in1_5(vector_cnt_lsb[5]), 
      .in1_4(vector_cnt_lsb[4]), .in1_3(vector_cnt_lsb[3]), .in1_2(vector_cnt_lsb[2]), 
      .in1_1(vector_cnt_lsb[1]), .in1_0(vector_cnt_lsb[0]), .in2_7(warmup_pattern_cnt[7]), 
      .in2_6(warmup_pattern_cnt[6]), .in2_5(warmup_pattern_cnt[5]), .in2_4(warmup_pattern_cnt[4]), 
      .in2_3(warmup_pattern_cnt[3]), .in2_2(warmup_pattern_cnt[2]), .in2_1(warmup_pattern_cnt[1]), 
      .in2_0(warmup_pattern_cnt[0])
  );
  M_RTLSIM_MUXN_2_1 rtlc3_12(
      .Z(lbist_sib_ijtag_from_so), .in_1(lbist_counter_ccm_le_so), .in_0(counter_bist_scan_out_retime), 
      .sel_0(ccm_scan_en)
  );
  RTLC_INV rtlc_16(
      .Z(rtlcn25), .A(ijtag_reset)
  );
  RTLC_OR2 rtlc_20(
      .Z(lbist_scan_en_int), .A(ccm_scan_en), .B(rtlc3n14)
  );
  RTLC_FDC rtlcreg_counter_bist_scan_out_retime(
      .Q(counter_bist_scan_out_retime), .D(rtlc2n12), .CP(rtlc2_neg_clk_n16), .CLR(rtlcn25)
  );
endmodule

