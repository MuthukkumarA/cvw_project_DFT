module msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_shift_reg(clk, 
                                                                              scan_en, 
                                                                              capture_cycle_width, 
                                                                              parallel_load_en, 
                                                                              parallel_load_value, 
                                                                              some_ones_left, 
                                                                              scan_in, 
                                                                              scan_out);
  input  [2:0] parallel_load_value;
  input  [1:0] capture_cycle_width;
  input  clk, scan_en, parallel_load_en, scan_in;
  output some_ones_left, scan_out;

  wire [2:0] FF;
  wire scan_in_gated, rtlc0_FF_SS1_n3_0, rtlc0_FF_SS1_n3_1, rtlc0_FF_SS1_n3_2, 
       rtlc0_FF_SS2_n4_0, rtlc0_FF_SS2_n4_1, rtlc0_FF_SS2_n4_2, rtlc0n9, 
       rtlc0_PS7_n27, rtlcClkX, rtlcXXX, rtlcn53, rtlcn54, rtlcn55;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_AND2 rtlc0_33(
      .Z(rtlc0n9), .A(parallel_load_en), .B(scan_en)
  );
  RTLC_BUF rtlc1_2(
      .Z(scan_out), .A(FF[0])
  );
  RTLC_AND2 rtlc1_3(
      .Z(scan_in_gated), .A(scan_in), .B(scan_en)
  );
  M_RTLSIM_MUXN_4_2 rtlc_41(
      .Z(rtlc0_FF_SS1_n3_1), .in_3(FF[2]), .in_2(FF[2]), .in_1(scan_in_gated), 
      .in_0(1'b0), .sel_1(capture_cycle_width[1]), .sel_0(capture_cycle_width[0])
  );
  M_RTLSIM_MUXN_2_1 rtlc_42(
      .Z(rtlc0_FF_SS1_n3_0), .in_1(scan_in_gated), .in_0(FF[1]), .sel_0(rtlc0_PS7_n27)
  );
  M_RTLSIM_MUXN_2_1 rtlc_44(
      .Z(rtlc0_FF_SS2_n4_0), .in_1(parallel_load_value[0]), .in_0(rtlc0_FF_SS1_n3_0), 
      .sel_0(rtlc0n9)
  );
  M_RTLSIM_MUXN_2_1 rtlc_45(
      .Z(rtlc0_FF_SS2_n4_1), .in_1(parallel_load_value[1]), .in_0(rtlc0_FF_SS1_n3_1), 
      .sel_0(rtlc0n9)
  );
  M_RTLSIM_MUXN_2_1 rtlc_46(
      .Z(rtlc0_FF_SS2_n4_2), .in_1(parallel_load_value[2]), .in_0(rtlc0_FF_SS1_n3_2), 
      .sel_0(rtlc0n9)
  );
  RTLC_AND2 rtlc_49(
      .Z(rtlc0_FF_SS1_n3_2), .A(scan_in_gated), .B(capture_cycle_width[1])
  );
  RTLC_INV rtlc_50(
      .Z(rtlcn53), .A(capture_cycle_width[1])
  );
  RTLC_INV rtlc_51(
      .Z(rtlcn54), .A(capture_cycle_width[0])
  );
  RTLC_AND2 rtlc_55(
      .Z(rtlc0_PS7_n27), .A(rtlcn53), .B(rtlcn54)
  );
  RTLC_OR2 rtlc_56(
      .Z(rtlcn55), .A(FF[0]), .B(FF[1])
  );
  RTLC_OR2 rtlc_57(
      .Z(some_ones_left), .A(rtlcn55), .B(FF[2])
  );
  RTLC_FD rtlcreg_FF_2(
      .Q(FF[2]), .D(rtlc0_FF_SS2_n4_2), .CP(clk)
  );
  RTLC_FD rtlcreg_FF_1(
      .Q(FF[1]), .D(rtlc0_FF_SS2_n4_1), .CP(clk)
  );
  RTLC_FD rtlcreg_FF_0(
      .Q(FF[0]), .D(rtlc0_FF_SS2_n4_0), .CP(clk)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_control(fast_clock, 
                                                                            slow_clock, 
                                                                            bypass_clock, 
                                                                            scan_en, 
                                                                            capture_en, 
                                                                            fast_capture_mode, 
                                                                            active_upstream_parent_occ, 
                                                                            capture_cycle_width, 
                                                                            test_mode, 
                                                                            inject_tck, 
                                                                            static_clock_control_mode, 
                                                                            static_clock_sequence, 
                                                                            shift_only_mode, 
                                                                            slow_clock_nf_en, 
                                                                            slow_clock_en, 
                                                                            clock_mux_select, 
                                                                            fast_clock_en, 
                                                                            scan_in, 
                                                                            scan_out);
  input  [2:0] static_clock_sequence;
  input  [1:0] capture_cycle_width;
  input  fast_clock, slow_clock, bypass_clock, scan_en, capture_en, 
         fast_capture_mode, active_upstream_parent_occ, test_mode, inject_tck, 
         static_clock_control_mode, shift_only_mode, scan_in;
  output slow_clock_nf_en, slow_clock_en, clock_mux_select, fast_clock_en, 
         scan_out;

  wire CAPTURE_EN_sync, ShiftReg_EN, BYPASS_SHIFT_FF, SCAN_OUT_d, 
       ShiftReg_SCAN_OUT, SHIFT_REG_CLK_en, SHIFT_REG_CLK_G, SHIFT_REG_CLK, 
       CE_SLOW_CLK, rtlcn0, rtlcn1, rtlc0n19, rtlc0n20, rtlc0n22, rtlc0n23, 
       rtlc0n25, rtlc0n26, rtlc0n28, rtlc0n29, rtlc0n32, rtlc0n34, rtlc0n36, 
       rtlc0n40, rtlc0n41, rtlc0n42, rtlc0n43, rtlc0n44, rtlc0n47, rtlc0n48, 
       rtlc0n49, rtlcClkX, rtlcXXX, rtlc2_neg_clk_n15, rtlc3n6, rtlc4n6, 
       rtlc4_neg_clk_n9;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_system_controllerwrapper_sys_controller_tessent_posedge_synchronizer_reset tessent_persistent_cell_ltest_ntc_sync_cell(
      .rn(rtlcn0), .d(CE_SLOW_CLK), .clk(fast_clock), .q(CAPTURE_EN_sync)
  );
  CLKGATETST_X8 tessent_persistent_cell_cgc_SHIFT_REG_CLK(
      .CK(fast_clock), .E(SHIFT_REG_CLK_en), .SE(SHIFT_REG_CLK_en), .GCK(SHIFT_REG_CLK_G)
  );
  MUX2_X2 tessent_persistent_cell_SHIFT_REG_CLK_mux(
      .A(SHIFT_REG_CLK_G), .B(slow_clock), .S(rtlcn1), .Z(SHIFT_REG_CLK)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_shift_reg ShiftReg(
      .clk(SHIFT_REG_CLK), .scan_en(scan_en), .capture_cycle_width(capture_cycle_width), 
      .parallel_load_en(static_clock_control_mode), .parallel_load_value(static_clock_sequence), 
      .some_ones_left(ShiftReg_EN), .scan_in(scan_in), .scan_out(ShiftReg_SCAN_OUT)
  );
  RTLC_INV rtlc0_8(
      .Z(rtlcn0), .A(rtlc0n20)
  );
  RTLC_INV rtlc0_10(
      .Z(rtlc0n19), .A(test_mode)
  );
  RTLC_INV rtlc0_12(
      .Z(rtlc0n22), .A(capture_en)
  );
  RTLC_INV rtlc0_13(
      .Z(rtlc0n23), .A(fast_capture_mode)
  );
  RTLC_AND2 rtlc0_14(
      .Z(slow_clock_nf_en), .A(rtlc0n25), .B(rtlc0n26)
  );
  RTLC_AND2 rtlc0_17(
      .Z(SHIFT_REG_CLK_en), .A(rtlc0n28), .B(rtlc0n29)
  );
  RTLC_AND2 rtlc0_18(
      .Z(rtlc0n28), .A(test_mode), .B(ShiftReg_EN)
  );
  M_RTLSIM_MUXN_2_1 rtlc0_20(
      .Z(SCAN_OUT_d), .in_1(BYPASS_SHIFT_FF), .in_0(ShiftReg_SCAN_OUT), .sel_0(rtlc0n32)
  );
  RTLC_AND2 rtlc0_24(
      .Z(rtlc0n36), .A(rtlc0n34), .B(rtlc0n29)
  );
  RTLC_AND2 rtlc0_25(
      .Z(rtlc0n34), .A(ShiftReg_SCAN_OUT), .B(fast_capture_mode)
  );
  RTLC_AND2 rtlc0_30(
      .Z(rtlc0n42), .A(rtlc0n41), .B(test_mode)
  );
  RTLC_AND2 rtlc0_32(
      .Z(rtlc0n40), .A(ShiftReg_SCAN_OUT), .B(rtlc0n23)
  );
  RTLC_AND2 rtlc0_34(
      .Z(rtlc0n44), .A(shift_only_mode), .B(scan_en)
  );
  RTLC_AND2 rtlc0_37(
      .Z(rtlc0n48), .A(rtlc0n47), .B(test_mode)
  );
  RTLC_INV rtlc2_1(
      .Z(rtlc2_neg_clk_n15), .A(slow_clock)
  );
  RTLC_AND2 rtlc3_0(
      .Z(rtlc3n6), .A(scan_in), .B(scan_en)
  );
  RTLC_AND2 rtlc4_0(
      .Z(rtlc4n6), .A(SCAN_OUT_d), .B(scan_en)
  );
  RTLC_INV rtlc4_2(
      .Z(rtlc4_neg_clk_n9), .A(bypass_clock)
  );
  RTLC_OR2 rtlc_67(
      .Z(rtlc0n25), .A(test_mode), .B(shift_only_mode)
  );
  RTLC_OR2 rtlc_68(
      .Z(rtlc0n26), .A(scan_en), .B(capture_en)
  );
  RTLC_OR2 rtlc_69(
      .Z(rtlc0n20), .A(scan_en), .B(rtlc0n19)
  );
  RTLC_OR2 rtlc_70(
      .Z(rtlc0n29), .A(CAPTURE_EN_sync), .B(active_upstream_parent_occ)
  );
  RTLC_OR2 rtlc_71(
      .Z(rtlcn1), .A(rtlc0n22), .B(rtlc0n23)
  );
  RTLC_OR2 rtlc_72(
      .Z(rtlc0n41), .A(rtlc0n40), .B(scan_en)
  );
  RTLC_OR2 rtlc_73(
      .Z(rtlc0n43), .A(rtlc0n42), .B(inject_tck)
  );
  RTLC_OR2 rtlc_74(
      .Z(slow_clock_en), .A(rtlc0n43), .B(rtlc0n44)
  );
  RTLC_OR2 rtlc_75(
      .Z(rtlc0n47), .A(scan_en), .B(rtlc0n23)
  );
  RTLC_OR2 rtlc_76(
      .Z(rtlc0n49), .A(rtlc0n48), .B(inject_tck)
  );
  RTLC_OR2 rtlc_77(
      .Z(clock_mux_select), .A(rtlc0n49), .B(rtlc0n44)
  );
  RTLC_OR2 rtlc_78(
      .Z(fast_clock_en), .A(rtlc0n36), .B(rtlc0n19)
  );
  RTLC_OR2 rtlc_79(
      .Z(rtlc0n32), .A(static_clock_control_mode), .B(rtlc0n19)
  );
  RTLC_FD rtlcreg_BYPASS_SHIFT_FF(
      .Q(BYPASS_SHIFT_FF), .D(rtlc3n6), .CP(bypass_clock)
  );
  RTLC_FD rtlcreg_scan_out(
      .Q(scan_out), .D(rtlc4n6), .CP(rtlc4_neg_clk_n9)
  );
  RTLC_FDC rtlcreg_CE_SLOW_CLK(
      .Q(CE_SLOW_CLK), .D(capture_en), .CP(rtlc2_neg_clk_n15), .CLR(rtlc0n19)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_sib(clock, 
                                                                        reset, 
                                                                        enable, 
                                                                        capture_en, 
                                                                        shift_en, 
                                                                        update_en, 
                                                                        scan_in, 
                                                                        from_scan_out, 
                                                                        scan_out, 
                                                                        to_enable);
  input  clock, reset, enable, capture_en, shift_en, update_en, scan_in, 
         from_scan_out;
  output scan_out, to_enable;

  wire sib, sib_latch, so_retime, to_enable_int, rtlcClkX, rtlcXXX, rtlc2n14, 
       rtlc2_neg_clk_n33, rtlc6_sib_SS1_n3, rtlc6_sib_SS3_n5, rtlc6n18, 
       rtlc6n24, rtlcn53, rtlcn54, rtlcn55;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_INV rtlc2_2(
      .Z(rtlc2_neg_clk_n33), .A(clock)
  );
  RTLC_AND2 rtlc2_13(
      .Z(rtlc2n14), .A(update_en), .B(enable)
  );
  RTLC_AND2 rtlc6_21(
      .Z(rtlc6n24), .A(shift_en), .B(enable)
  );
  RTLC_AND2 rtlc6_26(
      .Z(rtlc6n18), .A(capture_en), .B(enable)
  );
  RTLC_BUF rtlc7_1(
      .Z(scan_out), .A(so_retime)
  );
  RTLC_AND2 rtlc7_2(
      .Z(to_enable), .A(to_enable_int), .B(enable)
  );
  M_RTLSIM_MUXN_2_1 rtlc_39(
      .Z(rtlc6_sib_SS1_n3), .in_1(from_scan_out), .in_0(scan_in), .sel_0(sib_latch)
  );
  RTLC_INV rtlc_41(
      .Z(rtlcn54), .A(reset)
  );
  RTLC_INV rtlc_43(
      .Z(rtlcn55), .A(rtlc6n18)
  );
  RTLC_AND2 rtlc_44(
      .Z(rtlc6_sib_SS3_n5), .A(rtlc6_sib_SS1_n3), .B(rtlcn55)
  );
  RTLC_OR2 rtlc_48(
      .Z(rtlcn53), .A(rtlc6n24), .B(rtlc6n18)
  );
  RTLC_FD rtlcreg_to_enable_int(
      .Q(to_enable_int), .D(sib_latch), .CP(rtlc2_neg_clk_n33)
  );
  RTLC_FD rtlcreg_so_retime(
      .Q(so_retime), .D(sib), .CP(rtlc2_neg_clk_n33)
  );
  RTLC_FDCE rtlcreg_sib_latch(
      .Q(sib_latch), .D(sib), .CP(rtlc2_neg_clk_n33), .CLR(rtlcn54), .CE(rtlc2n14)
  );
  RTLC_FDCE rtlcreg_sib(
      .Q(sib), .D(rtlc6_sib_SS3_n5), .CP(clock), .CLR(rtlcn54), .CE(rtlcn53)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_ijtag_control(ijtag_tck, 
                                                                                  ijtag_reset, 
                                                                                  ijtag_sel, 
                                                                                  ijtag_ce, 
                                                                                  ijtag_se, 
                                                                                  ijtag_ue, 
                                                                                  ijtag_si, 
                                                                                  ijtag_so, 
                                                                                  fast_capture_mode, 
                                                                                  active_upstream_parent_occ, 
                                                                                  capture_cycle_width, 
                                                                                  static_clock_control_mode, 
                                                                                  clock_sequence, 
                                                                                  inject_tck, 
                                                                                  test_mode);
  input  ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_si;
  output [2:0] clock_sequence;
  output [1:0] capture_cycle_width;
  output ijtag_so, fast_capture_mode, active_upstream_parent_occ, 
         static_clock_control_mode, inject_tck, test_mode;

  wire [9:0] tdr;
  wire tdr_en, tdr_so_retime, rtlc0_tdr_SS2_n4_0, rtlc0_tdr_SS2_n4_1, 
       rtlc0_tdr_SS2_n4_2, rtlc0_tdr_SS2_n4_3, rtlc0_tdr_SS2_n4_4, 
       rtlc0_tdr_SS2_n4_5, rtlc0_tdr_SS2_n4_6, rtlc0_tdr_SS2_n4_7, 
       rtlc0_tdr_SS2_n4_8, rtlc0_tdr_SS2_n4_9, rtlc0n9, rtlc0n14, rtlcClkX, 
       rtlcXXX, rtlc1_neg_clk_n7, rtlc4n14, rtlcn50, rtlcn51, rtlcn61;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_sib tdr_sib(
      .clock(ijtag_tck), .reset(ijtag_reset), .enable(ijtag_sel), .capture_en(ijtag_ce), 
      .shift_en(ijtag_se), .update_en(ijtag_ue), .scan_in(ijtag_si), .from_scan_out(tdr_so_retime), 
      .scan_out(ijtag_so), .to_enable(tdr_en)
  );
  RTLC_AND2 rtlc0_49(
      .Z(rtlc0n14), .A(ijtag_se), .B(tdr_en)
  );
  RTLC_AND2 rtlc0_54(
      .Z(rtlc0n9), .A(ijtag_ce), .B(tdr_en)
  );
  RTLC_INV rtlc1_1(
      .Z(rtlc1_neg_clk_n7), .A(ijtag_tck)
  );
  RTLC_AND2 rtlc4_13(
      .Z(rtlc4n14), .A(ijtag_ue), .B(tdr_en)
  );
  RTLC_INV rtlc_103(
      .Z(rtlcn51), .A(rtlc0n9)
  );
  RTLC_AND2 rtlc_104(
      .Z(rtlc0_tdr_SS2_n4_9), .A(ijtag_si), .B(rtlcn51)
  );
  RTLC_AND2 rtlc_107(
      .Z(rtlc0_tdr_SS2_n4_8), .A(tdr[9]), .B(rtlcn51)
  );
  RTLC_AND2 rtlc_109(
      .Z(rtlc0_tdr_SS2_n4_7), .A(tdr[8]), .B(rtlcn51)
  );
  RTLC_AND2 rtlc_111(
      .Z(rtlc0_tdr_SS2_n4_6), .A(tdr[7]), .B(rtlcn51)
  );
  RTLC_AND2 rtlc_113(
      .Z(rtlc0_tdr_SS2_n4_5), .A(tdr[6]), .B(rtlcn51)
  );
  RTLC_AND2 rtlc_115(
