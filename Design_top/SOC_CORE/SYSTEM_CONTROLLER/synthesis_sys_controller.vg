module msrv_soc_system_controllerwrapper_sys_controller_tessent_edt_lbist_c1(edt_clock, 
                                                                             edt_update, 
                                                                             edt_bypass, 
                                                                             edt_single_bypass_chain, 
                                                                             edt_channels_in, 
                                                                             edt_channels_out, 
                                                                             edt_scan_in, 
                                                                             edt_scan_out, 
                                                                             lbist_reset, 
                                                                             lbist_en, 
                                                                             lbist_prpg_en, 
                                                                             misr_accumulate_en, 
                                                                             lbist_low_power_shift_en, 
                                                                             ijtag_tck, 
                                                                             ijtag_reset, 
                                                                             ijtag_sel, 
                                                                             ijtag_ce, 
                                                                             ijtag_se, 
                                                                             ijtag_ue, 
                                                                             ccm_en, 
                                                                             ccm_scan_in, 
                                                                             ccm_scan_out, 
                                                                             scan_en, 
                                                                             ijtag_si, 
                                                                             ijtag_so);
  input  [59:0] edt_scan_out;
  input  [1:0] edt_channels_in;
  input  edt_clock, edt_update, edt_bypass, edt_single_bypass_chain, 
         lbist_reset, lbist_en, lbist_prpg_en, misr_accumulate_en, 
         lbist_low_power_shift_en, ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, 
         ijtag_se, ijtag_ue, ccm_en, ccm_scan_in, scan_en, ijtag_si;
