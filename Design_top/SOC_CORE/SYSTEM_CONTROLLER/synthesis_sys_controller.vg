  RTLC_AND2 rtlc8_2(
      .Z(ijtag_to_sel), .A(to_enable_int), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc_32(
      .Z(rtlc7_sib_SS1_n2), .in_1(ijtag_from_so), .in_0(ijtag_si), .sel_0(sib_latch)
  );
  M_RTLSIM_MUXN_2_1 rtlc_33(
      .Z(rtlc7_sib_SS3_n4), .in_1(sib_latch), .in_0(rtlc7_sib_SS1_n2), .sel_0(rtlc7n10)
  );
  RTLC_INV rtlc_34(
      .Z(rtlcn37), .A(ijtag_reset)
  );
  RTLC_OR2 rtlc_41(
      .Z(rtlcn36), .A(rtlc7n15), .B(rtlc7n10)
  );
  RTLC_LDN rtlcreg_retiming_so(
      .Q(retiming_so), .D(sib), .GN(ijtag_tck)
  );
  RTLC_FDE rtlcreg_sib(
      .Q(sib), .D(rtlc7_sib_SS3_n4), .CP(ijtag_tck), .CE(rtlcn36)
  );
  RTLC_FDCE rtlcreg_sib_latch(
      .Q(sib_latch), .D(sib), .CP(rtlc2_neg_clk_n33), .CLR(rtlcn37), .CE(rtlc2n14)
  );
  RTLC_FDC rtlcreg_to_enable_int(
      .Q(to_enable_int), .D(sib_latch), .CP(rtlc2_neg_clk_n33), .CLR(rtlcn37)
  );
