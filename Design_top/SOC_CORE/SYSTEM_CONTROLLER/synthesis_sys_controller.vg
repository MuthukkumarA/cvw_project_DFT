  );
  RTLC_FDE rtlcreg_tdr_5(
      .Q(tdr[5]), .D(rtlc0_tdr_SS2_n4_5), .CP(ijtag_tck), .CE(rtlcn50)
  );
  RTLC_FDE rtlcreg_tdr_4(
      .Q(tdr[4]), .D(rtlc0_tdr_SS2_n4_4), .CP(ijtag_tck), .CE(rtlcn50)
  );
  RTLC_FDE rtlcreg_tdr_3(
      .Q(tdr[3]), .D(rtlc0_tdr_SS2_n4_3), .CP(ijtag_tck), .CE(rtlcn50)
  );
  RTLC_FDE rtlcreg_tdr_2(
      .Q(tdr[2]), .D(rtlc0_tdr_SS2_n4_2), .CP(ijtag_tck), .CE(rtlcn50)
  );
  RTLC_FDE rtlcreg_tdr_1(
      .Q(tdr[1]), .D(rtlc0_tdr_SS2_n4_1), .CP(ijtag_tck), .CE(rtlcn50)
  );
  RTLC_FDE rtlcreg_tdr_0(
      .Q(tdr[0]), .D(rtlc0_tdr_SS2_n4_0), .CP(ijtag_tck), .CE(rtlcn50)
  );
  RTLC_FD rtlcreg_tdr_so_retime(
      .Q(tdr_so_retime), .D(tdr[0]), .CP(rtlc1_neg_clk_n7)
  );
  RTLC_FDCE rtlcreg_test_mode(
      .Q(test_mode), .D(tdr[0]), .CP(rtlc1_neg_clk_n7), .CLR(rtlcn61), .CE(rtlc4n14)
  );
  RTLC_FDCE rtlcreg_fast_capture_mode(
