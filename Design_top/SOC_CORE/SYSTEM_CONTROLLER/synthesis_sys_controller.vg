module msrv_soc_system_controller(HADDR, HWRITE, HSIZE, HWDATA, HWSTRB, HREADY, 
                                  HTRANS, HRESPSYS_CTRL, HREADYSYS_CTRL, HSELSYS_CTRL, 
                                  clk, reset_ext, reset, clk_out, lbist_shift_clk, 
                                  tessent_persistent_cell_async_set_reset_dynamic_disable_ZN);
  input  [63:0] HWDATA;
  input  [55:0] HADDR;
  input  [7:0] HWSTRB;
  input  [2:0] HSIZE;
  input  [1:0] HTRANS;
  input  HWRITE, HREADY, clk, reset_ext, lbist_shift_clk, 
         tessent_persistent_cell_async_set_reset_dynamic_disable_ZN;
  output HRESPSYS_CTRL, HREADYSYS_CTRL, HSELSYS_CTRL, reset, clk_out;

  wire [31:0] clk_divider_reg, clk_shift_enb_reg, pmu_state_config;
  wire [12:0] HSELRegions;
  wire async_set_reset_dynamic_disable_inv_ts1, resetsync_q, 
       uart_powergate_enb, uart_isolation_enb, uart_retention_save_enb, 
       uart_retention_restore_enb, spi_powergate_enb, spi_isolation_enb, 
       spi_retention_save_enb, spi_retention_restore_enb, eeprom_powergate_enb, 
       eeprom_isolation_enb, rtlcClkX, rtlcXXX;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_reset_synchronizer resetsync(
      .clk(clk), .d(reset_ext), .q(resetsync_q)
  );
  msrv_soc_clk_generator clk_gen(
      .clk(clk), .reset(reset), .clk_divider_reg(clk_divider_reg), .clk_shift_enb_reg(clk_shift_enb_reg), 
      .clk_out(clk_out)
  );
  msrv_soc_register_bank reg_bank(
      .clk(clk), .reset(reset), .sel(HSELSYS_CTRL), .wr_enable(HWRITE), .ready(HREADY), 
      .trans(HTRANS), .addr(HADDR), .wdata(HWDATA), .ready_sys_ctrl(HREADYSYS_CTRL), 
      .resp_sys_ctrl(HRESPSYS_CTRL), .clk_divider_reg(clk_divider_reg), .clk_shift_enb_reg(clk_shift_enb_reg), 
      .pmu_state_config(pmu_state_config)
  );
  msrv_soc_adrdecs adrdecs(
      .PhysicalAddress(HADDR), .AccessRW(1'b1), .AccessRX(1'b1), .AccessRWXC(1'b1), 
      .Size(HSIZE[1:0]), .SelRegions(HSELRegions)
  );
  msrv_soc_pmu PMU(
      .clk(clk), .pmu_state_config(pmu_state_config), .uart_powergate_enb(uart_powergate_enb), 
      .uart_isolation_enb(uart_isolation_enb), .uart_retention_save_enb(uart_retention_save_enb), 
      .uart_retention_restore_enb(uart_retention_restore_enb), .spi_powergate_enb(spi_powergate_enb), 
      .spi_isolation_enb(spi_isolation_enb), .spi_retention_save_enb(spi_retention_save_enb), 
      .spi_retention_restore_enb(spi_retention_restore_enb), .eeprom_powergate_enb(eeprom_powergate_enb), 
      .eeprom_isolation_enb(eeprom_isolation_enb)
  );
  INV_X8 async_set_reset_dynamic_disable_inv(
      .A(tessent_persistent_cell_async_set_reset_dynamic_disable_ZN), .ZN(async_set_reset_dynamic_disable_inv_ts1)
  );
  AND2_X4 dft_ctrl_async_set_reset_dynamic_disable_inv_and2(
      .A1(resetsync_q), .A2(async_set_reset_dynamic_disable_inv_ts1), .ZN(reset)
  );
  RTLC_BUF rtlc0_0(
      .Z(HSELSYS_CTRL), .A(HSELRegions[12])
  );
endmodule

