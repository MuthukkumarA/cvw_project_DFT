module msrv_soc_system_controllerwrapper_sys_controller_tessent_edt_lbist_c1_tdr(ijtag_reset, 
                                                                                 ijtag_sel, 
                                                                                 ijtag_si, 
                                                                                 ijtag_ce, 
                                                                                 ijtag_se, 
                                                                                 ijtag_ue, 
                                                                                 ijtag_tck, 
                                                                                 edt_bypass, 
                                                                                 ijtag_so);
  input  ijtag_reset, ijtag_sel, ijtag_si, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_tck;
  output edt_bypass, ijtag_so;

  wire [0:0] tdr;
  wire edt_bypass_to_buf, retiming_so, edt_bypass_latch, rtlc0_tdr_SS2_n3_0, 
       rtlc0n8, rtlc0n13, rtlcClkX, rtlcXXX, rtlc1_neg_clk_n7, rtlc4n14, 
       rtlcn36, rtlcn37;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  BUF_X1 tessent_persistent_cell_edt_bypass(
      .A(edt_bypass_latch), .Z(edt_bypass)
  );
  RTLC_AND2 rtlc0_13(
      .Z(rtlc0n13), .A(ijtag_se), .B(ijtag_sel)
  );
  RTLC_AND2 rtlc0_18(
      .Z(rtlc0n8), .A(ijtag_ce), .B(ijtag_sel)
  );
  RTLC_INV rtlc1_1(
      .Z(rtlc1_neg_clk_n7), .A(ijtag_tck)
  );
  RTLC_AND2 rtlc4_13(
      .Z(rtlc4n14), .A(ijtag_ue), .B(ijtag_sel)
  );
  RTLC_BUF rtlc5_0(
      .Z(ijtag_so), .A(retiming_so)
  );
  M_RTLSIM_MUXN_2_1 rtlc_23(
      .Z(rtlc0_tdr_SS2_n3_0), .in_1(edt_bypass_latch), .in_0(ijtag_si), .sel_0(rtlc0n8)
  );
  RTLC_INV rtlc_26(
      .Z(rtlcn37), .A(ijtag_reset)
  );
  RTLC_OR2 rtlc_30(
      .Z(rtlcn36), .A(rtlc0n13), .B(rtlc0n8)
  );
  RTLC_FDE rtlcreg_tdr_0(
      .Q(tdr), .D(rtlc0_tdr_SS2_n3_0), .CP(ijtag_tck), .CE(rtlcn36)
  );
  RTLC_FD rtlcreg_retiming_so(
      .Q(retiming_so), .D(tdr), .CP(rtlc1_neg_clk_n7)
  );
  RTLC_FDCE rtlcreg_edt_bypass_latch(
      .Q(edt_bypass_latch), .D(tdr), .CP(rtlc1_neg_clk_n7), .CLR(rtlcn37), .CE(rtlc4n14)
  );
endmodule

