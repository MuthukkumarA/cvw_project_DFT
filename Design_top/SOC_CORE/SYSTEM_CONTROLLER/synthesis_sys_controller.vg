      .CLR(rtlcn54), .CE(rtlcn52)
  );
  RTLC_FDCE rtlcreg_capture_phase_size_0(
      .Q(capture_phase_size[0]), .D(rtlc2_capture_phase_size_SS2_n5_0), .CP(lbist_clock), 
      .CLR(rtlcn54), .CE(rtlcn52)
