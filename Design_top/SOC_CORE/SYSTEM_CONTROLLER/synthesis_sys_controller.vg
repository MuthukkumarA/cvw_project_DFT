      .Z(rtlc0n61), .A(lbist_fsm_reset), .B(lbist_sync_reset)
  );
  RTLC_OR2 rtlc_101(
      .Z(rtlc0n64), .A(lbist_setup[1]), .B(lbist_setup[2])
  );
  RTLC_OR2 rtlc_102(
      .Z(rtlc0n46), .A(capture_clock_en_buf_out), .B(shift_clock_en_buf_out)
  );
  RTLC_OR2 rtlc_103(
      .Z(rtlcn5), .A(rtlc0n46), .B(rtlc0n48)
  );
  RTLC_OR2 rtlc_104(
      .Z(rtlcn6), .A(ccm_scan_en), .B(rtlcn1)
  );
  RTLC_OR2 rtlc_105(
      .Z(rtlcn3), .A(ccm_scan_en), .B(rtlc0n41)
  );
  RTLC_OR2 rtlc_106(
      .Z(rtlcn77), .A(edt_update_in), .B(lbist_en)
  );
  RTLC_FDCE rtlcreg_ijtag_ccm_tdr_2(
      .Q(ijtag_ccm_tdr[2]), .D(ijtag_so), .CP(ijtag_tck), .CLR(rtlcn78), .CE(ccm_scan_en)
  );
  RTLC_FDCE rtlcreg_ijtag_ccm_tdr_1(
      .Q(ijtag_ccm_tdr[1]), .D(ijtag_ccm_tdr[2]), .CP(ijtag_tck), .CLR(rtlcn78), 
      .CE(ccm_scan_en)
  );
  RTLC_FDCE rtlcreg_ijtag_ccm_tdr_0(
      .Q(ijtag_ccm_tdr[0]), .D(ijtag_ccm_tdr[1]), .CP(ijtag_tck), .CLR(rtlcn78), 
      .CE(ccm_scan_en)
  );
  RTLC_FDC rtlcreg_ccm_te_si_lockup(
      .Q(ccm_te_si_lockup), .D(ijtag_ccm_tdr[0]), .CP(ijtag_tck), .CLR(rtlcn78)
  );
  RTLC_FDC rtlcreg_ijtag_so(
      .Q(ijtag_so), .D(rtlc8_ijtag_so_SS1_n6), .CP(ijtag_tck), .CLR(rtlcn78)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_single_chain_mode_logic_sib(ijtag_tck, 
                                                                                            ijtag_reset, 
                                                                                            ijtag_sel, 
                                                                                            ijtag_ce, 
                                                                                            ijtag_se, 
                                                                                            ijtag_ue, 
                                                                                            ijtag_si, 
                                                                                            ijtag_from_so, 
                                                                                            ccm_scan_en, 
                                                                                            ccm_te_si, 
                                                                                            ccm_te_so, 
                                                                                            ijtag_so, 
                                                                                            ijtag_to_sel);
  input  ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_si, ijtag_from_so, ccm_scan_en, ccm_te_si;
  output ccm_te_so, ijtag_so, ijtag_to_sel;

  wire sib, sib_latch, so_retime, to_enable_int, rtlcClkX, rtlcXXX, 
       rtlc2_sib_latch_SS2_n6, rtlc2n26, rtlc2_neg_clk_n48, rtlc3n8, 
       rtlc6_sib_SS1_n5, rtlc6_sib_SS3_n7, rtlc6_sib_SS4_n8, rtlc6n30, 
       rtlc6n39, rtlcn71, rtlcn72, rtlcn73, rtlcn74, rtlcn75;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_INV rtlc2_4(
      .Z(rtlc2_neg_clk_n48), .A(ijtag_tck)
  );
  RTLC_AND2 rtlc2_18(
      .Z(rtlc2n26), .A(ijtag_ue), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc3_0(
      .Z(rtlc3n8), .in_1(to_enable_int), .in_0(sib), .sel_0(ccm_scan_en)
  );
  RTLC_AND2 rtlc6_27(
      .Z(rtlc6n39), .A(ijtag_se), .B(ijtag_sel)
  );
  RTLC_AND2 rtlc6_34(
      .Z(rtlc6n30), .A(ijtag_ce), .B(ijtag_sel)
  );
  RTLC_BUF rtlc7_2(
      .Z(ccm_te_so), .A(so_retime)
  );
  RTLC_AND2 rtlc7_3(
      .Z(ijtag_to_sel), .A(to_enable_int), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_4(
      .Z(ijtag_so), .in_1(sib), .in_0(so_retime), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc_57(
      .Z(rtlc2_sib_latch_SS2_n6), .in_1(ccm_te_si), .in_0(sib), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc_58(
      .Z(rtlc6_sib_SS1_n5), .in_1(ijtag_from_so), .in_0(ijtag_si), .sel_0(sib_latch)
  );
  M_RTLSIM_MUXN_2_1 rtlc_60(
      .Z(rtlc6_sib_SS4_n8), .in_1(ijtag_from_so), .in_0(rtlc6_sib_SS3_n7), .sel_0(ccm_scan_en)
  );
  RTLC_INV rtlc_61(
      .Z(rtlcn74), .A(rtlc6n30)
  );
  RTLC_AND2 rtlc_62(
      .Z(rtlc6_sib_SS3_n7), .A(rtlc6_sib_SS1_n5), .B(rtlcn74)
  );
  RTLC_INV rtlc_63(
      .Z(rtlcn75), .A(ijtag_reset)
  );
  RTLC_OR2 rtlc_71(
      .Z(rtlcn72), .A(rtlc6n39), .B(rtlc6n30)
  );
  RTLC_OR2 rtlc_72(
      .Z(rtlcn73), .A(rtlcn72), .B(ccm_scan_en)
  );
  RTLC_OR2 rtlc_73(
      .Z(rtlcn71), .A(rtlc2n26), .B(ccm_scan_en)
  );
  RTLC_FD rtlcreg_to_enable_int(
      .Q(to_enable_int), .D(sib_latch), .CP(rtlc2_neg_clk_n48)
  );
  RTLC_FD rtlcreg_so_retime(
      .Q(so_retime), .D(rtlc3n8), .CP(rtlc2_neg_clk_n48)
  );
  RTLC_FDCE rtlcreg_sib_latch(
      .Q(sib_latch), .D(rtlc2_sib_latch_SS2_n6), .CP(rtlc2_neg_clk_n48), .CLR(rtlcn75), 
      .CE(rtlcn71)
  );
  RTLC_FDCE rtlcreg_sib(
      .Q(sib), .D(rtlc6_sib_SS4_n8), .CP(ijtag_tck), .CLR(rtlcn75), .CE(rtlcn73)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_single_chain_mode_logic(ijtag_tck, 
                                                                                        lbist_en, 
                                                                                        ijtag_reset, 
                                                                                        ijtag_sel, 
                                                                                        ijtag_ce, 
                                                                                        ijtag_se, 
                                                                                        ijtag_ue, 
                                                                                        ccm_en, 
                                                                                        ccm_scan_out, 
                                                                                        scan_en, 
                                                                                        ccm_scan_in, 
                                                                                        ijtag_si, 
                                                                                        edt_single_bypass_chain_in, 
                                                                                        edt_channels_in, 
                                                                                        edt_channels_out, 
                                                                                        ijtag_so, 
                                                                                        edt_single_bypass_chain_out, 
                                                                                        to_edt_channels_in);
  input  ijtag_tck, lbist_en, ijtag_reset, ijtag_sel, ijtag_ce, ijtag_se, 
         ijtag_ue, ccm_en, scan_en, ccm_scan_in, ijtag_si, 
         edt_single_bypass_chain_in, edt_channels_in, edt_channels_out;
  output ccm_scan_out, ijtag_so, edt_single_bypass_chain_out, 
         to_edt_channels_in;

  wire [2:0] ijtag_ccm_tdr;
  wire tdr_sib_scan_out, single_chain_sib_scan_out, tdr_single_bypass_en, 
       tdr_single_bypass, ccm_en_buf_out, tdr_single_bypass_buf_out, 
       ijtag_si_int, blk_sib_en, blk1_sib_scan_out, blk1_sib_from_scan_out, 
       ccm_scan_en, ijtag_sel_ccm, ijtag_ce_ccm, ijtag_se_ccm, ijtag_ue_ccm, 
       ccm_te_si_lockup, ccm_te_so_tdr_sib, ccm_te_so_single_chain_sib, 
       ccm_te_so_blk1_sib, rtlcClkX, rtlcXXX, rtlc6n20, rtlc6n22, rtlc7n19, 
       rtlc7n21, rtlc7n23, rtlc7n26, rtlcn43, rtlcn44, rtlcn45;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  BUF_X1 tessent_persistent_cell_ccm_en_buf(
      .A(ccm_en), .Z(ccm_en_buf_out)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_single_chain_mode_logic_sib tdr_sib_i(
      .ijtag_tck(ijtag_tck), .ijtag_reset(ijtag_reset), .ijtag_sel(ijtag_sel_ccm), 
      .ijtag_ce(ijtag_ce_ccm), .ijtag_se(ijtag_se_ccm), .ijtag_ue(ijtag_ue_ccm), 
      .ijtag_si(ijtag_si_int), .ijtag_from_so(tdr_single_bypass), .ccm_scan_en(ccm_scan_en), 
      .ccm_te_si(ccm_te_si_lockup), .ccm_te_so(ccm_te_so_tdr_sib), .ijtag_so(tdr_sib_scan_out), 
      .ijtag_to_sel(tdr_single_bypass_en)
  );
  BUF_X1 tessent_persistent_cell_tdr_single_bypass_buf(
      .A(tdr_single_bypass), .Z(tdr_single_bypass_buf_out)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_single_chain_mode_logic_sib single_chain_sib_i(
      .ijtag_tck(ijtag_tck), .ijtag_reset(ijtag_reset), .ijtag_sel(ijtag_sel_ccm), 
      .ijtag_ce(ijtag_ce_ccm), .ijtag_se(ijtag_se_ccm), .ijtag_ue(ijtag_ue_ccm), 
      .ijtag_si(tdr_sib_scan_out), .ijtag_from_so(blk1_sib_scan_out), .ccm_scan_en(ccm_scan_en), 
      .ccm_te_si(ccm_te_so_tdr_sib), .ccm_te_so(ccm_te_so_single_chain_sib), .ijtag_so(single_chain_sib_scan_out), 
      .ijtag_to_sel(blk_sib_en)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_single_chain_mode_logic_sib blk1_sib_i(
      .ijtag_tck(ijtag_tck), .ijtag_reset(ijtag_reset), .ijtag_sel(blk_sib_en), 
      .ijtag_ce(ijtag_ce_ccm), .ijtag_se(ijtag_se_ccm), .ijtag_ue(ijtag_ue_ccm), 
      .ijtag_si(tdr_sib_scan_out), .ijtag_from_so(blk1_sib_from_scan_out), .ccm_scan_en(ccm_scan_en), 
      .ccm_te_si(ccm_te_so_single_chain_sib), .ccm_te_so(ccm_te_so_blk1_sib), .ijtag_so(blk1_sib_scan_out), 
      .ijtag_to_sel()
  );
  RTLC_AND2 rtlc6_15(
      .Z(rtlc6n20), .A(ijtag_se_ccm), .B(tdr_single_bypass_en)
  );
  RTLC_BUF rtlc7_3(
      .Z(ijtag_so), .A(single_chain_sib_scan_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_11(
      .Z(ijtag_si_int), .in_1(ccm_scan_in), .in_0(ijtag_si), .sel_0(ccm_en_buf_out)
  );
  RTLC_AND2 rtlc7_12(
      .Z(ccm_scan_en), .A(scan_en), .B(ccm_en_buf_out)
  );
  RTLC_AND2 rtlc7_13(
      .Z(ccm_scan_out), .A(ccm_te_so_blk1_sib), .B(ccm_en_buf_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_14(
      .Z(ijtag_sel_ccm), .in_1(ijtag_ccm_tdr[0]), .in_0(ijtag_sel), .sel_0(ccm_en_buf_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_15(
      .Z(ijtag_ce_ccm), .in_1(rtlc7n19), .in_0(ijtag_ce), .sel_0(ccm_en_buf_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_17(
      .Z(ijtag_se_ccm), .in_1(rtlc7n21), .in_0(ijtag_se), .sel_0(ccm_en_buf_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_19(
      .Z(ijtag_ue_ccm), .in_1(rtlc7n23), .in_0(ijtag_ue), .sel_0(ccm_en_buf_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_21(
      .Z(blk1_sib_from_scan_out), .in_1(tdr_sib_scan_out), .in_0(edt_channels_out), 
      .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_22(
      .Z(edt_single_bypass_chain_out), .in_1(tdr_single_bypass_buf_out), .in_0(rtlc7n26), 
      .sel_0(lbist_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc7_24(
      .Z(to_edt_channels_in), .in_1(tdr_sib_scan_out), .in_0(edt_channels_in), 
      .sel_0(edt_single_bypass_chain_out)
  );
  RTLC_INV rtlc_30(
      .Z(rtlcn43), .A(ijtag_reset)
  );
  RTLC_INV rtlc_32(
      .Z(rtlcn44), .A(ijtag_ccm_tdr[2])
  );
  RTLC_INV rtlc_34(
      .Z(rtlcn45), .A(ijtag_ccm_tdr[1])
  );
  RTLC_AND2 rtlc_39(
      .Z(rtlc7n19), .A(rtlcn44), .B(ijtag_ccm_tdr[1])
  );
  RTLC_AND2 rtlc_40(
      .Z(rtlc7n21), .A(ijtag_ccm_tdr[2]), .B(rtlcn45)
  );
  RTLC_AND2 rtlc_41(
      .Z(rtlc7n23), .A(ijtag_ccm_tdr[2]), .B(ijtag_ccm_tdr[1])
  );
  RTLC_OR2 rtlc_47(
      .Z(rtlc6n22), .A(rtlc6n20), .B(ccm_scan_en)
  );
  RTLC_OR2 rtlc_48(
      .Z(rtlc7n26), .A(edt_single_bypass_chain_in), .B(tdr_single_bypass_buf_out)
  );
  RTLC_FD rtlcreg_ccm_te_si_lockup(
      .Q(ccm_te_si_lockup), .D(ijtag_ccm_tdr[0]), .CP(ijtag_tck)
  );
  RTLC_FDCE rtlcreg_ijtag_ccm_tdr_2(
      .Q(ijtag_ccm_tdr[2]), .D(single_chain_sib_scan_out), .CP(ijtag_tck), .CLR(rtlcn43), 
      .CE(ccm_scan_en)
  );
  RTLC_FDCE rtlcreg_ijtag_ccm_tdr_1(
      .Q(ijtag_ccm_tdr[1]), .D(ijtag_ccm_tdr[2]), .CP(ijtag_tck), .CLR(rtlcn43), 
      .CE(ccm_scan_en)
  );
  RTLC_FDCE rtlcreg_ijtag_ccm_tdr_0(
      .Q(ijtag_ccm_tdr[0]), .D(ijtag_ccm_tdr[1]), .CP(ijtag_tck), .CLR(rtlcn43), 
      .CE(ccm_scan_en)
  );
  RTLC_FDCE rtlcreg_tdr_single_bypass(
      .Q(tdr_single_bypass), .D(ijtag_si_int), .CP(ijtag_tck), .CLR(rtlcn43), .CE(rtlc6n22)
  );
endmodule

module M_RTLSIM_MUXN_DCZ_4_2(Z, in_3, in_2, in_1, in_0, sel_1, sel_0);
  input  in_3, in_2, in_1, in_0, sel_1, sel_0;
  output Z;

  wire rtlcN_out_mux0;

  RTLC_MUX4 mux4inst0(
      .Z(Z), .A(sel_0), .B(sel_1), .D0(in_0), .D1(in_1), .D2(in_2), .D3(in_3)
  );
endmodule

module M_RTLSIM_MUXN_2_1(Z, in_1, in_0, sel_0);
  input  in_1, in_0, sel_0;
  output Z;

  RTLC_MUX2 muxinst(
      .Z(Z), .A(in_0), .B(in_1), .S(sel_0)
  );
endmodule

module M_RTLSIM_INCR_2(cout, out_1, out_0, in_1, in_0, cin);
  input  in_1, in_0, cin;
  output cout, out_1, out_0;

  wire carry0;

  RTLC_HADD inst0(
      .S(out_0), .CO(carry0), .A(cin), .B(in_0)
  );
  RTLC_HADD inst1(
      .S(out_1), .CO(cout), .A(carry0), .B(in_1)
  );
endmodule

module M_RTLSIM_EQ_8(Z, in1_7, in1_6, in1_5, in1_4, in1_3, in1_2, in1_1, in1_0, 
                     in2_7, in2_6, in2_5, in2_4, in2_3, in2_2, in2_1, in2_0);
  input  in1_7, in1_6, in1_5, in1_4, in1_3, in1_2, in1_1, in1_0, in2_7, in2_6, 
         in2_5, in2_4, in2_3, in2_2, in2_1, in2_0;
  output Z;

  wire tmp7, tmp6, tmp5, tmp4, tmp3, tmp2, tmp1, tmp0;

  RTLC_XNOR2 inst7(
      .Z(tmp7), .A(in1_7), .B(in2_7)
  );
  RTLC_XNOR2 inst6(
      .Z(tmp6), .A(in1_6), .B(in2_6)
  );
  RTLC_XNOR2 inst5(
      .Z(tmp5), .A(in1_5), .B(in2_5)
  );
  RTLC_XNOR2 inst4(
      .Z(tmp4), .A(in1_4), .B(in2_4)
  );
  RTLC_XNOR2 inst3(
      .Z(tmp3), .A(in1_3), .B(in2_3)
  );
  RTLC_XNOR2 inst2(
      .Z(tmp2), .A(in1_2), .B(in2_2)
  );
  RTLC_XNOR2 inst1(
      .Z(tmp1), .A(in1_1), .B(in2_1)
  );
  RTLC_XNOR2 inst0(
      .Z(tmp0), .A(in1_0), .B(in2_0)
  );
  M_RTLSIM_AND_8 inst_a(
      .Z(Z), .in1(tmp0), .in2(tmp1), .in3(tmp2), .in4(tmp3), .in5(tmp4), .in6(tmp5), 
      .in7(tmp6), .in8(tmp7)
  );
endmodule

module M_RTLSIM_AND_8(Z, in1, in2, in3, in4, in5, in6, in7, in8);
  input  in1, in2, in3, in4, in5, in6, in7, in8;
  output Z;

  wire rtlcN0, rtlcN1;

  RTLC_AND4 rtlcm_0(
      .Z(rtlcN0), .A(in1), .B(in2), .C(in3), .D(in4)
  );
  RTLC_AND4 rtlcm_1(
      .Z(rtlcN1), .A(in5), .B(in6), .C(in7), .D(in8)
  );
  RTLC_AND2 rtlcm_2(
      .Z(Z), .A(rtlcN0), .B(rtlcN1)
  );
endmodule

module M_RTLSIM_MUXN_6_3(Z, in_5, in_4, in_3, in_2, in_1, in_0, sel_2, sel_1, sel_0);
  input  in_5, in_4, in_3, in_2, in_1, in_0, sel_2, sel_1, sel_0;
  output Z;

  wire rtlcN_out_mux1, rtlcN_out_mux0;

  RTLC_MUX2 mux2inst(
      .Z(rtlcN_out_mux1), .A(in_4), .B(in_5), .S(sel_0)
  );
  RTLC_MUX4 mux4inst0(
      .Z(rtlcN_out_mux0), .A(sel_0), .B(sel_1), .D0(in_0), .D1(in_1), .D2(in_2), 
      .D3(in_3)
  );
  M_RTLSIM_MUXN_2_1 rtlcm_0(
      .Z(Z), .in_1(rtlcN_out_mux1), .in_0(rtlcN_out_mux0), .sel_0(sel_2)
  );
endmodule

module M_RTLSIM_MUX_2_2(Z, in1, sel1, in2, sel2);
  input  in1, sel1, in2, sel2;
  output Z;

  RTLC_AO22 rtlcm_0(
      .Z(Z), .A(in1), .B(sel1), .C(in2), .D(sel2)
  );
endmodule

module M_RTLSIM_DECR_3(cout, out_2, out_1, out_0, in_2, in_1, in_0, cin);
  input  in_2, in_1, in_0, cin;
  output cout, out_2, out_1, out_0;

  wire extkry, carry0, carry1;

  RTLC_INV inst0(
      .Z(extkry), .A(cin)
  );
  RTLC_XNOR2 xnorinst0(
      .Z(out_0), .A(extkry), .B(in_0)
  );
  RTLC_OR2 orinst0(
      .Z(carry0), .A(extkry), .B(in_0)
  );
  RTLC_XNOR2 xnorinst1(
      .Z(out_1), .A(carry0), .B(in_1)
  );
  RTLC_OR2 orinst1(
      .Z(carry1), .A(carry0), .B(in_1)
  );
  RTLC_XNOR2 xnorinst2(
      .Z(out_2), .A(carry1), .B(in_2)
  );
  RTLC_OR2 orinst2(
      .Z(cout), .A(carry1), .B(in_2)
  );
endmodule

module M_RTLSIM_DECR_4(cout, out_3, out_2, out_1, out_0, in_3, in_2, in_1, in_0, 
                       cin);
  input  in_3, in_2, in_1, in_0, cin;
  output cout, out_3, out_2, out_1, out_0;

  wire extkry, carry0, carry1, carry2;

  RTLC_INV inst0(
      .Z(extkry), .A(cin)
  );
  RTLC_XNOR2 xnorinst0(
      .Z(out_0), .A(extkry), .B(in_0)
  );
  RTLC_OR2 orinst0(
      .Z(carry0), .A(extkry), .B(in_0)
  );
  RTLC_XNOR2 xnorinst1(
      .Z(out_1), .A(carry0), .B(in_1)
  );
  RTLC_OR2 orinst1(
      .Z(carry1), .A(carry0), .B(in_1)
  );
  RTLC_XNOR2 xnorinst2(
      .Z(out_2), .A(carry1), .B(in_2)
  );
  RTLC_OR2 orinst2(
      .Z(carry2), .A(carry1), .B(in_2)
  );
  RTLC_XNOR2 xnorinst3(
      .Z(out_3), .A(carry2), .B(in_3)
  );
  RTLC_OR2 orinst3(
      .Z(cout), .A(carry2), .B(in_3)
  );
endmodule

