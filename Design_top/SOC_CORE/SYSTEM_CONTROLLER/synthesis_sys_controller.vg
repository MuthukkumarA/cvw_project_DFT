module msrv_soc_system_controllerwrapper_sys_controller_tessent_occ(fast_clock, 
                                                                    slow_clock, 
                                                                    scan_en, capture_en, 
                                                                    static_clock_control_mode, 
                                                                    clock_sequence, 
                                                                    shift_only_mode, 
                                                                    ijtag_tck, 
                                                                    ijtag_reset, 
                                                                    ijtag_sel, 
                                                                    ijtag_ce, ijtag_se, 
                                                                    ijtag_ue, ijtag_si, 
                                                                    ijtag_so, clock_out, 
                                                                    scan_in, scan_out);
  input  [2:0] clock_sequence;
  input  fast_clock, slow_clock, scan_en, capture_en, 
         static_clock_control_mode, shift_only_mode, ijtag_tck, ijtag_reset, 
         ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, ijtag_si, scan_in;
  output ijtag_so, clock_out, scan_out;

  wire [2:0] ijtag_clock_sequence, clock_sequence_buf_out, rtlcn1;
  wire [1:0] capture_cycle_width;
  wire inject_tck, slow_clock_tck_injected, slow_clock_nf_en, slow_clock_nf, 
       fast_clock_en, slow_clock_en, slow_clock_gated, clock_mux_select, 
       fast_clock_gated, test_mode, fast_capture_mode, 
       active_upstream_parent_occ, ijtag_static_clock_control_mode, 
       fast_clock_buf_out, slow_clock_buf_out, scan_en_buf_out, 
       capture_en_buf_out, static_clock_control_mode_buf_out, scan_in_buf_out, 
       scan_out_buf_in, rtlcn0, rtlcClkX, rtlcXXX;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  CLKBUF_X3 tessent_persistent_cell_fast_clock_buf(
      .A(fast_clock), .Z(fast_clock_buf_out)
  );
  CLKBUF_X3 tessent_persistent_cell_slow_clock_buf(
      .A(slow_clock), .Z(slow_clock_buf_out)
  );
  BUF_X1 tessent_persistent_cell_scan_en_buf(
      .A(scan_en), .Z(scan_en_buf_out)
  );
  BUF_X1 tessent_persistent_cell_capture_en_buf(
      .A(capture_en), .Z(capture_en_buf_out)
  );
  BUF_X1 tessent_persistent_cell_static_clock_control_mode_buf(
      .A(static_clock_control_mode), .Z(static_clock_control_mode_buf_out)
  );
  BUF_X1 tessent_persistent_cell_clock_sequence_buf_0(
      .A(clock_sequence[0]), .Z(clock_sequence_buf_out[0])
  );
  BUF_X1 tessent_persistent_cell_clock_sequence_buf_1(
      .A(clock_sequence[1]), .Z(clock_sequence_buf_out[1])
  );
  BUF_X1 tessent_persistent_cell_clock_sequence_buf_2(
      .A(clock_sequence[2]), .Z(clock_sequence_buf_out[2])
  );
  BUF_X1 tessent_persistent_cell_scan_in_buf(
      .A(scan_in), .Z(scan_in_buf_out)
  );
  BUF_X1 tessent_persistent_cell_scan_out_buf(
      .A(scan_out_buf_in), .Z(scan_out)
  );
  CLKGATETST_X8 tessent_persistent_cell_cgc_slow_clock_nf(
      .CK(slow_clock_buf_out), .E(slow_clock_nf_en), .SE(slow_clock_nf_en), .GCK(slow_clock_nf)
  );
  MUX2_X2 tessent_persistent_cell_inject_tck_mux(
      .A(slow_clock_nf), .B(ijtag_tck), .S(inject_tck), .Z(slow_clock_tck_injected)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_control occ_control(
      .fast_clock(fast_clock_buf_out), .slow_clock(slow_clock_tck_injected), .bypass_clock(clock_out), 
      .scan_en(scan_en_buf_out), .capture_en(capture_en_buf_out), .fast_capture_mode(fast_capture_mode), 
      .active_upstream_parent_occ(active_upstream_parent_occ), .capture_cycle_width(capture_cycle_width), 
      .test_mode(test_mode), .inject_tck(inject_tck), .static_clock_control_mode(rtlcn0), 
      .static_clock_sequence(rtlcn1), .shift_only_mode(shift_only_mode), .slow_clock_nf_en(slow_clock_nf_en), 
      .slow_clock_en(slow_clock_en), .clock_mux_select(clock_mux_select), .fast_clock_en(fast_clock_en), 
      .scan_in(scan_in_buf_out), .scan_out(scan_out_buf_in)
  );
  msrv_soc_system_controllerwrapper_sys_controller_tessent_occ_ijtag_control ijtag_control(
      .ijtag_tck(ijtag_tck), .ijtag_reset(ijtag_reset), .ijtag_sel(ijtag_sel), 
      .ijtag_ce(ijtag_ce), .ijtag_se(ijtag_se), .ijtag_ue(ijtag_ue), .ijtag_si(ijtag_si), 
      .ijtag_so(ijtag_so), .fast_capture_mode(fast_capture_mode), .active_upstream_parent_occ(active_upstream_parent_occ), 
      .capture_cycle_width(capture_cycle_width), .static_clock_control_mode(ijtag_static_clock_control_mode), 
      .clock_sequence(ijtag_clock_sequence), .inject_tck(inject_tck), .test_mode(test_mode)
  );
  CLKGATETST_X8 tessent_persistent_cell_cgc_fast_clock(
      .CK(fast_clock_buf_out), .E(fast_clock_en), .SE(fast_clock_en), .GCK(fast_clock_gated)
  );
  CLKGATETST_X8 tessent_persistent_cell_cgc_slow_clock(
      .CK(slow_clock_tck_injected), .E(slow_clock_en), .SE(slow_clock_en), .GCK(slow_clock_gated)
  );
  MUX2_X2 tessent_persistent_cell_clock_out_mux(
      .A(fast_clock_gated), .B(slow_clock_gated), .S(clock_mux_select), .Z(clock_out)
  );
  M_RTLSIM_MUXN_2_1 rtlc0_5(
      .Z(rtlcn1[0]), .in_1(ijtag_clock_sequence[0]), .in_0(clock_sequence_buf_out[0]), 
      .sel_0(ijtag_static_clock_control_mode)
  );
  M_RTLSIM_MUXN_2_1 rtlc0_6(
      .Z(rtlcn1[1]), .in_1(ijtag_clock_sequence[1]), .in_0(clock_sequence_buf_out[1]), 
      .sel_0(ijtag_static_clock_control_mode)
  );
  M_RTLSIM_MUXN_2_1 rtlc0_7(
      .Z(rtlcn1[2]), .in_1(ijtag_clock_sequence[2]), .in_0(clock_sequence_buf_out[2]), 
      .sel_0(ijtag_static_clock_control_mode)
  );
  RTLC_OR2 rtlc_10(
      .Z(rtlcn0), .A(static_clock_control_mode_buf_out), .B(ijtag_static_clock_control_mode)
  );
endmodule

module msrv_soc_system_controllerwrapper_sys_controller_tessent_edt_c1_sib(ijtag_tck, 
                                                                           ijtag_reset, 
                                                                           ijtag_sel, 
                                                                           ijtag_ce, 
                                                                           ijtag_se, 
                                                                           ijtag_ue, 
                                                                           ijtag_si, 
                                                                           ijtag_from_so, 
                                                                           ccm_scan_en, 
                                                                           ccm_te_si, 
                                                                           ccm_te_so, 
                                                                           ijtag_so, 
                                                                           ijtag_to_sel);
  input  ijtag_tck, ijtag_reset, ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue, 
         ijtag_si, ijtag_from_so, ccm_scan_en, ccm_te_si;
  output ccm_te_so, ijtag_so, ijtag_to_sel;

  wire sib, sib_latch, so_retime, to_enable_int, ijtag_from_so_retime, 
       rtlcClkX, rtlcXXX, rtlc2_sib_latch_SS2_n6, rtlc2n26, rtlc2_neg_clk_n48, 
       rtlc3n8, rtlc4n6, rtlc7_sib_SS1_n5, rtlc7_sib_SS3_n7, rtlc7_sib_SS4_n8, 
       rtlc7n30, rtlc7n39, rtlcn71, rtlcn72, rtlcn73, rtlcn74, rtlcn75;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_INV rtlc2_4(
      .Z(rtlc2_neg_clk_n48), .A(ijtag_tck)
  );
  RTLC_AND2 rtlc2_18(
      .Z(rtlc2n26), .A(ijtag_ue), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc3_0(
      .Z(rtlc3n8), .in_1(to_enable_int), .in_0(sib), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc4_0(
      .Z(rtlc4n6), .in_1(so_retime), .in_0(ijtag_from_so), .sel_0(ccm_scan_en)
  );
  RTLC_AND2 rtlc7_27(
      .Z(rtlc7n39), .A(ijtag_se), .B(ijtag_sel)
  );
  RTLC_AND2 rtlc7_34(
      .Z(rtlc7n30), .A(ijtag_ce), .B(ijtag_sel)
  );
  RTLC_BUF rtlc8_2(
      .Z(ccm_te_so), .A(ijtag_from_so_retime)
  );
  RTLC_AND2 rtlc8_3(
      .Z(ijtag_to_sel), .A(to_enable_int), .B(ijtag_sel)
  );
  M_RTLSIM_MUXN_2_1 rtlc8_4(
      .Z(ijtag_so), .in_1(sib), .in_0(so_retime), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc_58(
      .Z(rtlc2_sib_latch_SS2_n6), .in_1(ccm_te_si), .in_0(sib), .sel_0(ccm_scan_en)
  );
  M_RTLSIM_MUXN_2_1 rtlc_59(
      .Z(rtlc7_sib_SS1_n5), .in_1(ijtag_from_so_retime), .in_0(ijtag_si), .sel_0(sib_latch)
  );
  M_RTLSIM_MUXN_2_1 rtlc_61(
      .Z(rtlc7_sib_SS4_n8), .in_1(ijtag_from_so), .in_0(rtlc7_sib_SS3_n7), .sel_0(ccm_scan_en)
  );
  RTLC_INV rtlc_62(
      .Z(rtlcn74), .A(rtlc7n30)
  );
  RTLC_AND2 rtlc_63(
      .Z(rtlc7_sib_SS3_n7), .A(rtlc7_sib_SS1_n5), .B(rtlcn74)
  );
  RTLC_INV rtlc_64(
      .Z(rtlcn75), .A(ijtag_reset)
  );
  RTLC_OR2 rtlc_72(
      .Z(rtlcn72), .A(rtlc7n39), .B(rtlc7n30)
  );
  RTLC_OR2 rtlc_73(
      .Z(rtlcn73), .A(rtlcn72), .B(ccm_scan_en)
  );
  RTLC_OR2 rtlc_74(
      .Z(rtlcn71), .A(rtlc2n26), .B(ccm_scan_en)
  );
  RTLC_FD rtlcreg_to_enable_int(
      .Q(to_enable_int), .D(sib_latch), .CP(rtlc2_neg_clk_n48)
  );
  RTLC_FD rtlcreg_so_retime(
      .Q(so_retime), .D(rtlc3n8), .CP(rtlc2_neg_clk_n48)
  );
  RTLC_FD rtlcreg_ijtag_from_so_retime(
      .Q(ijtag_from_so_retime), .D(rtlc4n6), .CP(rtlc2_neg_clk_n48)
  );
  RTLC_FDCE rtlcreg_sib_latch(
      .Q(sib_latch), .D(rtlc2_sib_latch_SS2_n6), .CP(rtlc2_neg_clk_n48), .CLR(rtlcn75), 
      .CE(rtlcn71)
  );
  RTLC_FDCE rtlcreg_sib(
      .Q(sib), .D(rtlc7_sib_SS4_n8), .CP(ijtag_tck), .CLR(rtlcn75), .CE(rtlcn73)
  );
endmodule

