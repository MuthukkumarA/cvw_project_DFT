  );
  RTLC_AND2 rtlc_79(
      .Z(rtlc2_warmup_pattern_cnt_SS2_n5_2), .A(warmup_pattern_cnt[3]), .B(lbist_scan_en)
  );
  RTLC_AND2 rtlc_80(
