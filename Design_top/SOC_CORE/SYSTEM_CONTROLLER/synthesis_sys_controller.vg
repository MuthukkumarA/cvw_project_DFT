module msrv_soc_system_controllerwrapper_sys_controller_tessent_edt_c1_spatial_compactor_30_w_output_lockup(edt_clock, 
                                                                                                            multi_bit_input, 
                                                                                                            single_bit_output, 
                                                                                                            lbist_misr_in, 
                                                                                                            ccm_scan_en, 
                                                                                                            ccm_te_si, 
                                                                                                            ccm_te_so, 
                                                                                                            ccm_le_si, 
                                                                                                            ccm_le_so);
  input  [29:0] multi_bit_input;
  input  edt_clock, ccm_scan_en, ccm_te_si, ccm_le_si;
  output [29:0] lbist_misr_in;
  output single_bit_output, ccm_te_so, ccm_le_so;

  wire [14:0] level1;
  wire [7:0] level2;
  wire [3:0] level3;
  wire [1:0] level4;
  wire level5_pipelined, rtlcClkX, rtlcXXX, rtlc4_level5_pipelined_SS1_n2, 
       rtlc4n11, rtlc5_single_bit_output_SS1_n2, rtlc5_neg_clk_n14;
