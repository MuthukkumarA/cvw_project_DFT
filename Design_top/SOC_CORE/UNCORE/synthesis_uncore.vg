module msrv_soc_synchronizer(clk, resetn, enable, d_in, d_out);
  input  clk, resetn, enable, d_in;
  output d_out;

  wire sync_reg_1, sync_reg_2, rtlcClkX, rtlcXXX, rtlcn36;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_BUF rtlc3_0(
      .Z(d_out), .A(sync_reg_2)
  );
  RTLC_INV rtlc_23(
      .Z(rtlcn36), .A(resetn)
  );
  RTLC_FDCE rtlcreg_sync_reg_2(
      .Q(sync_reg_2), .D(sync_reg_1), .CP(clk), .CLR(rtlcn36), .CE(enable)
  );
  RTLC_FDCE rtlcreg_sync_reg_1(
      .Q(sync_reg_1), .D(d_in), .CP(clk), .CLR(rtlcn36), .CE(enable)
  );
endmodule

module msrv_soc_apb_master(PCLK, PRESETn, s_req_p, s_ack_p, s_addr, s_trans_valid, 
                           s_strb, s_sel, s_write, s_wdata, s_rdata, PADDR, PENABLE, 
                           PWRITE, PSTRB, PWDATA, PSEL, PRDATA, PREADY);
  input  [319:0] PRDATA;
  input  [63:0] s_wdata;
  input  [55:0] s_addr;
  input  [7:0] s_strb;
  input  [4:0] s_sel, PREADY;
  input  PCLK, PRESETn, s_req_p, s_trans_valid, s_write;
  output [63:0] s_rdata, PWDATA;
  output [55:0] PADDR;
  output [7:0] PSTRB;
  output [4:0] PSEL;
  output s_ack_p, PENABLE, PWRITE;

  wire [63:0] rdata;
