module msrv_soc_uncore(HCLK, HRESETn, HADDR, HWDATA, HWSTRB, HWRITE, HSIZE, HBURST, 
                       HPROT, HTRANS, HMASTLOCK, HRDATAEXT, HREADYEXT, HRESPEXT, 
                       HRDATA, HREADY, HRESP, HSELEXT, MTimerInt, MSwInt, MExtInt, 
                       SExtInt, MTIME_CLINT, out_pad_oen, out_pad_o, in_pad_i, 
                       PCLK, PRESETn, lbist_shift_clk);
