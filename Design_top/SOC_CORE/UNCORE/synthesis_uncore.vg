       HSELPLICD, HSELGPIOD, HSELUARTD, HSELSDCD, HSELSPID, HSELSYS_CTRLD, 
       HRESPRam, HRESPSDC, HREADYRam, HRESPSDCD, HSELBootRom, HSELBootRomD, 
       HRESPBootRom, HREADYBootRom, HREADYSDC, HSELNoneD, UARTIntr, GPIOIntr, 
       SPIIntr, SDCIntM, PWRITE, PENABLE, HRESPBRIDGE, HREADYBRIDGE, 
       HSELBRIDGE, HSELBRIDGED, HSELEXTSDCD, rtlcn1, \uartgen.RTSb , 
       \uartgen.DTRb , \uartgen.OUT1b , \uartgen.OUT2b , \uartgen.TXRDYb , 
       \uartgen.RXRDYb , rtlc0n113, rtlc0n114, rtlc0n115, rtlc0n182, rtlc0n199, 
       rtlc0n201, rtlc0n202, rtlc0n203, rtlc0n204, rtlc0n205, rtlc0n207, 
       rtlc0n209, rtlc0n210, rtlc0n211, rtlc0n212, rtlc0n213, rtlc0n214, 
       rtlc0n215, rtlcClkX, rtlcXXX;
