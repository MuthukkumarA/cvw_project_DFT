                                                                    edt_channels_out, 
                                                                    edt_scan_in, 
                                                                    edt_scan_out, 
                                                                    edt_scan_out_lockup, 
                                                                    edt_bypass_in, 
                                                                    edt_bypass_out);
  input  [59:0] edt_scan_out, edt_bypass_in;
  input  [1:0] edt_channels_in, edt_bypass_out;
  input  edt_bypass, edt_single_bypass_chain, lbist_en, ccm_en;
