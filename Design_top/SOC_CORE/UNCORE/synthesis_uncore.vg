module msrv_soc_adrdecs(PhysicalAddress, AccessRW, AccessRX, AccessRWXC, Size, 
                        SelRegions);
  input  [55:0] PhysicalAddress;
  input  [1:0] Size;
  input  AccessRW, AccessRX, AccessRWXC;
  output [12:0] SelRegions;

  wire rtlc0n6, rtlcClkX, rtlcXXX, rtlcn9, rtlcn10, rtlcn11, rtlcn12, rtlcn13, 
       rtlcn14, rtlcn15, rtlcn16, rtlcn17, rtlcn18;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_adrdec dtimdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000010000000000000000000000000000000), 
      .Range(56'b00000000000000000000000000000000011111111111111111111111), .Supported(1'b0), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[1])
  );
  msrv_soc_adrdec iromdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000010000000000000000000000000000000), 
      .Range(56'b00000000000000000000000000000000011111111111111111111111), .Supported(1'b0), 
      .AccessValid(AccessRX), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[2])
  );
  msrv_soc_adrdec ddr4dec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000010000000000000000000000000000000), 
      .Range(56'b00000000000000000000000000000111111111111111111111111111), .Supported(1'b0), 
      .AccessValid(AccessRWXC), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[3])
  );
  msrv_soc_adrdec bootromdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000000000000000000001000000000000), 
      .Range(56'b00000000000000000000000000000000000000000000111111111111), .Supported(1'b1), 
      .AccessValid(AccessRWXC), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[4])
  );
  msrv_soc_adrdec uncoreramdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000010000000000000000000000000000000), 
      .Range(56'b00000000000000000000000000000111111111111111111111111111), .Supported(1'b1), 
      .AccessValid(AccessRWXC), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[5])
  );
  msrv_soc_adrdec clintdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000000010000000000000000000000000), 
      .Range(56'b00000000000000000000000000000000000000001111111111111111), .Supported(1'b1), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[6])
  );
  msrv_soc_adrdec gpiodec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000010000000001100000000000000000), 
      .Range(56'b00000000000000000000000000000000000000000000000011111111), .Supported(1'b1), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b0100), .Sel(SelRegions[7])
  );
  msrv_soc_adrdec uartdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000010000000000000000000000000000), 
      .Range(56'b00000000000000000000000000000000000000000000000000000111), .Supported(1'b1), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b0001), .Sel(SelRegions[8])
  );
  msrv_soc_adrdec plicdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000001100000000000000000000000000), 
      .Range(56'b00000000000000000000000000000011111111111111111111111111), .Supported(1'b1), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b0100), .Sel(SelRegions[9])
  );
  msrv_soc_adrdec sdcdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000000000000000010011000000000000), 
      .Range(56'b00000000000000000000000000000000000000000000000001111111), .Supported(1'b0), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b1100), .Sel(SelRegions[10])
  );
  msrv_soc_adrdec spidec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000010000000001000000000000000000), 
      .Range(56'b00000000000000000000000000000000000000000000111111111111), .Supported(1'b1), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b0100), .Sel(SelRegions[11])
  );
  msrv_soc_adrdec systemcontrollerdec(
      .PhysicalAddress(PhysicalAddress), .Base(56'b00000000000000000000000000010000000000110000000000000000), 
      .Range(56'b00000000000000000000000000000000000000000000000000011111), .Supported(1'b1), 
      .AccessValid(AccessRW), .Size(Size), .SizeMask(4'b1111), .Sel(SelRegions[12])
  );
  RTLC_INV rtlc0_1(
      .Z(SelRegions[0]), .A(rtlc0n6)
  );
  RTLC_OR2 rtlc_15(
      .Z(rtlcn9), .A(SelRegions[1]), .B(SelRegions[2])
  );
  RTLC_OR2 rtlc_16(
      .Z(rtlcn10), .A(SelRegions[3]), .B(SelRegions[4])
  );
  RTLC_OR2 rtlc_17(
      .Z(rtlcn15), .A(rtlcn9), .B(rtlcn10)
  );
  RTLC_OR2 rtlc_18(
      .Z(rtlcn11), .A(SelRegions[5]), .B(SelRegions[6])
  );
  RTLC_OR2 rtlc_19(
      .Z(rtlcn12), .A(SelRegions[7]), .B(SelRegions[8])
  );
  RTLC_OR2 rtlc_20(
      .Z(rtlcn16), .A(rtlcn11), .B(rtlcn12)
  );
  RTLC_OR2 rtlc_21(
      .Z(rtlcn18), .A(rtlcn15), .B(rtlcn16)
  );
  RTLC_OR2 rtlc_22(
      .Z(rtlcn13), .A(SelRegions[9]), .B(SelRegions[10])
  );
  RTLC_OR2 rtlc_23(
      .Z(rtlcn14), .A(SelRegions[11]), .B(SelRegions[12])
  );
  RTLC_OR2 rtlc_24(
      .Z(rtlcn17), .A(rtlcn13), .B(rtlcn14)
  );
  RTLC_OR2 rtlc_25(
      .Z(rtlc0n6), .A(rtlcn18), .B(rtlcn17)
  );
