      .PhysicalAddress(HADDR), .AccessRW(1'b1), .AccessRX(1'b1), .AccessRWXC(1'b1), 
      .Size(HSIZE[1:0]), .SelRegions(HSELRegions)
  );
  msrv_soc_ahbapbbridge ahbapbbridge(
      .HCLK(HCLK), .HRESETn(HRESETn), .HSEL({HSELSPI, HSELUART, HSELPLIC, 
      HSELCLINT, HSELGPIO}), .HADDR(HADDR), .HTRANS(HTRANS), .HWSTRB(HWSTRB), .HWRITE(HWRITE), 
      .HREADY(HREADY), .HWDATA(HWDATA), .HREADYOUT(HREADYBRIDGE), .HRDATA(HREADBRIDGE), 
      .HRESP(HRESPBRIDGE), .PCLK(PCLK), .PRESETn(PRESETn), .PADDR(PADDR), .PENABLE(PENABLE), 
      .PSTRB(PSTRB), .PWRITE(PWRITE), .PWDATA(PWDATA), .PSEL(PSEL), .PRDATA(PRDATA), 
      .PREADY(PREADY)
  );
  msrv_soc_flopenl hseldelayreg(
      .clk(HCLK), .load(rtlcn1), .en(HREADY), .d(HSELRegions), .val(13'b0000000000001), 
      .q({HSELSYS_CTRLD, HSELSPID, HSELEXTSDCD, HSELPLICD, HSELUARTD, 
      HSELGPIOD, HSELCLINTD, HSELRamD, HSELBootRomD, HSELEXTD, HSELIROMD, 
      HSELDTIMD, HSELNoneD})
  );
  msrv_soc_flopenr hselbridgedelayreg(
      .clk(HCLK), .reset(rtlcn1), .en(HREADY), .d(HSELBRIDGE), .q(HSELBRIDGED)
  );
  msrv_soc_rom_ahb \bootrom.bootrom (
      .HCLK(HCLK), .HRESETn(HRESETn), .HSELRom(HSELBootRom), .HADDR(HADDR), .HWRITE(HWRITE), 
      .HWDATA(HWDATA), .HWSTRB(HWSTRB), .HREADY(HREADY), .HTRANS(HTRANS), .HREADRom(HREADBootRom), 
      .HRESPRom(HRESPBootRom), .HREADYRom(HREADYBootRom)
  );
  msrv_soc_clint_apb \clint.clint (
      .PCLK(PCLK), .PRESETn(PRESETn), .PSEL(PSEL[1]), .PADDR(PADDR[15:0]), .PWDATA(PWDATA), 
      .PSTRB(PSTRB), .PWRITE(PWRITE), .PENABLE(PENABLE), .PRDATA(PRDATA[127:64]), 
      .PREADY(PREADY[1]), .MTIME(MTIME_CLINT), .MTimerInt(MTimerInt), .MSwInt(MSwInt)
  );
  msrv_soc_plic_apb \plic.plic (
      .PCLK(PCLK), .PRESETn(PRESETn), .PSEL(PSEL[2]), .PADDR(PADDR[27:0]), .PWDATA(PWDATA), 
      .PSTRB(PSTRB), .PWRITE(PWRITE), .PENABLE(PENABLE), .PRDATA(PRDATA[191:128]), 
      .PREADY(PREADY[2]), .UARTIntr(UARTIntr), .GPIOIntr(GPIOIntr), .SPIIntr(SPIIntr), 
      .SDCIntr(1'b0), .MExtInt(MExtInt), .SExtInt(SExtInt)
  );
  msrv_soc_gpio_apb \gpio.gpio (
      .PCLK(PCLK), .PRESET(PRESETn), .PRDATA(PRDATA[63:0]), .PADDR(PADDR[7:0]), 
      .PWDATA(PWDATA), .PSEL(PSEL[0]), .PENABLE(PENABLE), .PWRITE(PWRITE), .aux_in(aux_in), 
      .IRQ(GPIOIntr), .PREADY(PREADY[0]), .out_pad_oen(out_pad_oen), .out_pad_o(out_pad_o), 
      .in_pad_i(in_pad_i)
  );
  msrv_soc_uart_apb \uartgen.uart (
      .PCLK(PCLK), .PRESETn(PRESETn), .PSEL(PSEL[3]), .PADDR(PADDR[2:0]), .PWDATA(PWDATA), 
      .PSTRB(PSTRB), .PWRITE(PWRITE), .PENABLE(PENABLE), .PRDATA(PRDATA[255:192]), 
      .PREADY(PREADY[3]), .SIN(in_pad_i[31]), .DSRb(1'b1), .DCDb(1'b1), .CTSb(1'b0), 
      .RIb(1'b1), .SOUT(aux_in[7]), .RTSb(\uartgen.RTSb ), .DTRb(\uartgen.DTRb ), 
      .OUT1b(\uartgen.OUT1b ), .OUT2b(\uartgen.OUT2b ), .INTR(UARTIntr), .TXRDYb(\uartgen.TXRDYb ), 
      .RXRDYb(\uartgen.RXRDYb )
  );
  msrv_soc_spi_apb \spi.spi (
      .PCLK(PCLK), .PRESETn(PRESETn), .PSEL(PSEL[4]), .PADDR(PADDR[7:0]), .PWDATA(PWDATA), 
      .PSTRB(PSTRB), .PWRITE(PWRITE), .PENABLE(PENABLE), .PREADY(PREADY[4]), .PRDATA(PRDATA[319:256]), 
      .SPIOut(aux_in[5]), .SPIIn(in_pad_i[29]), .SPICS(aux_in[4:1]), .SPIIntr(SPIIntr), 
      .SPICLK(aux_in[0])
  );
  RTLC_BUF rtlc0_7(
      .Z(HSELPLIC), .A(HSELRegions[9])
  );
  RTLC_BUF rtlc0_8(
      .Z(HSELEXTSDC), .A(HSELRegions[10])
  );
  RTLC_BUF rtlc0_9(
      .Z(HSELSPI), .A(HSELRegions[11])
  );
  RTLC_BUF rtlc0_10(
      .Z(HSELCLINT), .A(HSELRegions[6])
  );
  RTLC_BUF rtlc0_11(
      .Z(HSELGPIO), .A(HSELRegions[7])
  );
  RTLC_BUF rtlc0_12(
      .Z(HSELUART), .A(HSELRegions[8])
  );
  RTLC_BUF rtlc0_13(
      .Z(HSELEXT), .A(HSELRegions[3])
  );
  RTLC_BUF rtlc0_14(
      .Z(HSELBootRom), .A(HSELRegions[4])
  );
  RTLC_BUF rtlc0_15(
      .Z(HSELRam), .A(HSELRegions[5])
  );
