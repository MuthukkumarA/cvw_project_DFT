module msrv_soc_flopenl(clk, load, en, d, val, q);
  input  [12:0] d, val;
  input  clk, load, en;
  output [12:0] q;

  wire rtlc0_q_SS2_n2_0, rtlc0_q_SS2_n2_1, rtlc0_q_SS2_n2_2, rtlc0_q_SS2_n2_3, 
       rtlc0_q_SS2_n2_4, rtlc0_q_SS2_n2_5, rtlc0_q_SS2_n2_6, rtlc0_q_SS2_n2_7, 
       rtlc0_q_SS2_n2_8, rtlc0_q_SS2_n2_9, rtlc0_q_SS2_n2_10, 
       rtlc0_q_SS2_n2_11, rtlc0_q_SS2_n2_12, rtlcClkX, rtlcXXX, rtlcn39;
