module msrv_soc_uart_apb(PCLK, PRESETn, PSEL, PADDR, PWDATA, PSTRB, PWRITE, PENABLE, 
                         PRDATA, PREADY, SIN, DSRb, DCDb, CTSb, RIb, SOUT, RTSb, 
                         DTRb, OUT1b, OUT2b, INTR, TXRDYb, RXRDYb);
  input  [63:0] PWDATA;
  input  [7:0] PSTRB;
  input  [2:0] PADDR;
  input  PCLK, PRESETn, PSEL, PWRITE, PENABLE, SIN, DSRb, DCDb, CTSb, RIb;
  output [63:0] PRDATA;
  output PREADY, SOUT, RTSb, DTRb, OUT1b, OUT2b, INTR, TXRDYb, RXRDYb;

  wire [7:0] Din, Dout;
  wire [2:0] entry;
  wire MEMRb, MEMWb, memread, memwrite, BAUDOUTb, rtlc0n15, rtlc0n17, rtlc0n18, 
       rtlcClkX, rtlcXXX;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_uartPC16550D uartPC(
      .PCLK(PCLK), .PRESETn(PRESETn), .A(entry), .Din(Din), .Dout(Dout), .MEMRb(MEMRb), 
      .MEMWb(MEMWb), .INTR(INTR), .TXRDYb(TXRDYb), .RXRDYb(RXRDYb), .BAUDOUTb(BAUDOUTb), 
      .RCLK(BAUDOUTb), .SIN(SIN), .DSRb(DSRb), .DCDb(DCDb), .CTSb(CTSb), .RIb(RIb), 
      .SOUT(SOUT), .RTSb(RTSb), .DTRb(DTRb), .OUT1b(OUT1b), .OUT2b(OUT2b)
  );
  RTLC_BUF rtlc0_0(
      .Z(PRDATA[0]), .A(Dout[0])
  );
  RTLC_BUF rtlc0_1(
      .Z(PRDATA[1]), .A(Dout[1])
  );
