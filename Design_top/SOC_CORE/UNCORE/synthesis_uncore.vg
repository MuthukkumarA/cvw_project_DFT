module msrv_soc_uncorewrapper_pass2_rtl_tessent_lbist_ctrl(lbist_clock, lbist_en, 
                                                           ccm_scan_en, ccm_le_si, 
                                                           ccm_le_so, ccm_te_si, 
                                                           ccm_te_so, capture_phase_size, 
                                                           lbist_scan_in, lbist_scan_out, 
                                                           shift_phase, lbist_reset, 
                                                           lbist_run_mode, lbist_burn_in, 
                                                           prpg_en, warmup_done, 
                                                           last_bit, last_vector, 
                                                           ijtag_tck, ijtag_reset, 
                                                           ijtag_sel, ijtag_ce, 
                                                           ijtag_se, ijtag_ue);
