  input  [9:0] d;
  input  clk, reset;
  output [9:0] q;

  wire rtlc0_q_SS1_n1_0, rtlc0_q_SS1_n1_1, rtlc0_q_SS1_n1_2, rtlc0_q_SS1_n1_3, 
       rtlc0_q_SS1_n1_4, rtlc0_q_SS1_n1_5, rtlc0_q_SS1_n1_6, rtlc0_q_SS1_n1_7, 
       rtlc0_q_SS1_n1_8, rtlc0_q_SS1_n1_9, rtlcClkX, rtlcXXX, rtlcn14;
