module msrv_soc_flopr(clk, reset, d, q);
  input  [0:0] d;
  input  clk, reset;
  output [0:0] q;

  wire rtlc0_q_SS1_n1_0, rtlcClkX, rtlcXXX, rtlcn14;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_INV rtlc_10(
      .Z(rtlcn14), .A(reset)
  );
  RTLC_AND2 rtlc_11(
      .Z(rtlc0_q_SS1_n1_0), .A(d), .B(rtlcn14)
  );
  RTLC_FD rtlcreg_q_0(
      .Q(q), .D(rtlc0_q_SS1_n1_0), .CP(clk)
  );
endmodule

