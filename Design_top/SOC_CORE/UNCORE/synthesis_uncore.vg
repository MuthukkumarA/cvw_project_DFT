  wire [7:0] FCR, LCR, LSR, SCR, DLL, DLM, rxdata, TXHR, nexttxdata, rtlc12n5;
  wire [6:6] rtlc9n23, rtlc11n18;
  wire [5:5] rtlc9n24, rtlc11n19;
  wire [4:4] rtlc9n25, rtlc11n20;
  wire [4:0] MCR, rxfifotailunwrapped, rtlc0n53, rtlc4n79, rtlc7n636, 
             rtlc12n509;
  wire [3:3] rtlc9n26, rtlc11n21;
  wire [3:0] IER, MSR, rxoversampledcnt, txoversampledcnt, rxbitsreceived, 
             txbitssent, rxfifohead, rxfifotail, txfifohead, txfifotail, 
             rxfifotriggerlevel, rxfifoentries, rxbitsexpected, txbitsexpected, 
             rtlc0n607, rtlc0n612, rtlc0n675, rtlc4n72, rtlc7n612, rtlc10n45, 
             rtlc10n51, rtlc12n481;
  wire [2:2] rtlc9n27, rtlc11n22;
  wire [2:0] intrID;
  wire [1:1] rtlc9n28, rtlc11n23;
  wire [1:0] rxstate, txstate, rtlc0n687;
  wire [0:0] rtlc9n29, rtlc11n24;
  wire SINd, DSRbd, DCDbd, CTSbd, RIbd, SINsync, DSRbsync, DCDbsync, CTSbsync, 
       RIbsync, DSRb2, DCDb2, CTSb2, RIb2, SOUTbit, loop, DLAB, baudpulse, 
