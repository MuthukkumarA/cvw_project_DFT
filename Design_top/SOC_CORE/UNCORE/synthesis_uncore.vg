module msrv_soc_uncorewrapper_pass2_rtl_tessent_lbist(ijtag_tck, test_clock, shift_clock_src, 
                                                      edt_lbist_clock, lbist_test_clock_out, 
                                                      to_edt_scan_in, from_edt_scan_out, 
                                                      ijtag_si, ijtag_so, lbist_en, 
                                                      lbist_reset, edt_update_in, 
                                                      edt_update_out, ccm_en, ccm_scan_in, 
                                                      ccm_scan_out, lbist_low_power_shift_en, 
                                                      scan_en_in, scan_en_out, 
                                                      shift_capture_clock_out, 
                                                      shift_en_out, capture_en_out, 
                                                      lbist_prpg_en, misr_accumulate_en, 
                                                      ijtag_reset, ijtag_sel, ijtag_ce, 
                                                      ijtag_se, ijtag_ue, edt_sib_en);
  input  ijtag_tck, test_clock, shift_clock_src, from_edt_scan_out, ijtag_si, 
         edt_update_in, ccm_en, ccm_scan_in, scan_en_in, ijtag_reset, 
         ijtag_sel, ijtag_ce, ijtag_se, ijtag_ue;
  output edt_lbist_clock, lbist_test_clock_out, to_edt_scan_in, ijtag_so, 
         lbist_en, lbist_reset, edt_update_out, ccm_scan_out, 
         lbist_low_power_shift_en, scan_en_out, shift_capture_clock_out, 
         shift_en_out, capture_en_out, lbist_prpg_en, misr_accumulate_en, 
         edt_sib_en;

  wire [2:0] ijtag_ccm_tdr, capture_phase_size, lbist_setup;
  wire [1:0] shift_clock_select, shift_clock_select_buf_out;
  wire ccm_te_si_lockup, lbist_en_int, test_clock_buf_out, lbist_clock_en_int, 
       scan_en_in_buf, lbist_fsm_ccm_scan_out, ccm_en_buf_out, ccm_scan_en, 
       from_edt_scan_out_int, lbist_burn_in, prpg_en_int, misr_en_int, 
       shift_clock_en_int, shift_clock_en_buf_out, shift_phase_int, 
       shift_phase_buf_out, capture_clock_en_int, capture_clock_en_buf_out, 
       capture_en_int, capture_en_buf_out, last_bit, last_vector, 
       scan_en_select, shift_capture_clock_int, shift_clock_int, 
       lbist_fsm_reset, lbist_done, lbist_run_mode, lbist_clock_disable, 
       lbist_clock_disable_sync, lbist_sync_reset, lbist_ctrl_bist_scan_out, 
       lbist_ctrl_signals_scan_out, warmup_done, lbist_edt_sib_scan_out, 
       ijtag_so_d, ijtag_sel_ccm, ijtag_ce_ccm, ijtag_se_ccm, ijtag_ue_ccm, 
       ccm_le_so_lbist_ctrl, ccm_te_so_lbist_ctrl, 
       ccm_le_so_lbist_ctrl_signals, ccm_te_so_lbist_ctrl_signals, 
       ccm_te_so_lbist_fsm, ccm_te_so_lbist_edt_sib, rtlcn0, rtlcn1, rtlcn3, 
       rtlcn4, rtlcn5, rtlcn6, rtlc0n33, rtlc0n38, rtlc0n39, rtlc0n41, 
       rtlc0n46, rtlc0n47, rtlc0n48, rtlc0n53, rtlc0n55, rtlc0n57, rtlc0n61, 
       rtlc0n64, rtlc0n66, rtlc0n69, rtlc0n70, rtlc0n71, rtlcClkX, rtlcXXX, 
       rtlc8_ijtag_so_SS1_n6, rtlc8n22, rtlc8n23, rtlc8n24, rtlc8n25, rtlcn77, 
       rtlcn78, rtlcn79, rtlcn80, rtlcn81;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  BUF_X1 tessent_persistent_cell_lbist_en_buf(
      .A(lbist_en_int), .Z(lbist_en)
  );
  BUF_X1 tessent_persistent_cell_ccm_en_buf(
