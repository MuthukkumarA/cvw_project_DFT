module msrv_soc_rom_ahb(HCLK, HRESETn, HSELRom, HADDR, HWRITE, HWDATA, HWSTRB, 
                        HREADY, HTRANS, HREADRom, HRESPRom, HREADYRom);
  input  [63:0] HWDATA;
  input  [55:0] HADDR;
  input  [7:0] HWSTRB;
  input  [1:0] HTRANS;
  input  HCLK, HRESETn, HSELRom, HWRITE, HREADY;
  output [63:0] HREADRom;
  output HRESPRom, HREADYRom;

  wire [63:0] HWADATARom;
  wire [55:0] HADDRD, RomAddr;
  wire initTrans, memwrite, memwriteD, memread, nextHREADYRom, DelayReady, 
       rtlcn0, rtlcn3, rtlc0n23, rtlc0n25, rtlc0n28, rtlc0n30, rtlcClkX, 
       rtlcXXX, rtlcn82;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  msrv_soc_flopenr memwritereg(
      .clk(HCLK), .reset(rtlcn0), .en(HREADY), .d(memwrite), .q(memwriteD)
  );
  msrv_soc_flopenr_pv1 haddrreg(
      .clk(HCLK), .reset(rtlcn0), .en(HREADY), .d(HADDR), .q(HADDRD)
  );
  msrv_soc_flopr readyreg(
      .clk(HCLK), .reset(rtlcn0), .d(nextHREADYRom), .q(HREADYRom)
  );
  msrv_soc_mux2 adrmux(
      .d0(HADDR), .d1(HADDRD), .s(rtlcn3), .y(RomAddr)
  );
  msrv_soc_eeprom memory(
      .clk(HCLK), .rst_n(HRESETn), .write_enable(memwriteD), .address(RomAddr), 
      .write_data(HWADATARom), .read_data(HREADRom)
  );
  RTLC_BUF rtlc0_4(
      .Z(DelayReady), .A(1'b0)
  );
  RTLC_BUF rtlc0_9(
      .Z(HRESPRom), .A(1'b0)
  );
  RTLC_INV rtlc0_10(
      .Z(rtlcn0), .A(HRESETn)
  );
  RTLC_INV rtlc0_14(
      .Z(rtlc0n23), .A(HREADY)
  );
  RTLC_AND2 rtlc0_15(
      .Z(initTrans), .A(rtlc0n25), .B(HTRANS[1])
  );
  RTLC_AND2 rtlc0_16(
      .Z(rtlc0n25), .A(HREADY), .B(HSELRom)
  );
  RTLC_AND2 rtlc0_17(
      .Z(memwrite), .A(initTrans), .B(HWRITE)
  );
  RTLC_AND2 rtlc0_18(
      .Z(memread), .A(initTrans), .B(rtlc0n28)
  );
  RTLC_INV rtlc0_19(
      .Z(rtlc0n28), .A(HWRITE)
  );
  RTLC_AND2 rtlc0_22(
      .Z(rtlc0n30), .A(memwriteD), .B(memread)
  );
  RTLC_INV rtlc_221(
      .Z(nextHREADYRom), .A(rtlcn82)
  );
  RTLC_AND2 rtlc_288(
      .Z(HWADATARom[0]), .A(HWDATA[0]), .B(HWSTRB[0])
