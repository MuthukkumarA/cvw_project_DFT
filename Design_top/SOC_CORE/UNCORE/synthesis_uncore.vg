  output HREADY, HRESP, HSELEXT, MTimerInt, MSwInt, MExtInt, SExtInt;

  wire [319:0] PRDATA;
  wire [63:0] HREADRam, HREADSDC, HREADBootRom, PWDATA, HREADBRIDGE, rtlc0n118, 
              rtlc0n184, rtlc0n187, rtlc0n189, rtlc0n192, rtlc0n194;
