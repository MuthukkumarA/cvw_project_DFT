Core(msrv_soc_uncorewrapper_pass2_rtl_tessent_edt_lbist_c1) {
  Scan {
    module_type : edt;
    allow_scan_out_retiming : 1;
    is_hard_module : 1;
    Mode(controller_chain_mode) {
      traceable : 0;
      make_active_automatically : 0;
      ModeEn(ccm_en) {
        active_polarity : 1'b1;
      }
      Clock(ijtag_tck) {
        off_state : 1'b0;
      }
      ScanEn(scan_en) {
        active_polarity : 1'b1;
      }
      ScanChain {
        length : 332;
        scan_in_port : ccm_scan_in;
        scan_out_port : ccm_scan_out;
        scan_in_clock : ijtag_tck;
        scan_out_clock : ~ijtag_tck;
      }
    }
  }
}

