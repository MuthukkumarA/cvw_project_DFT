Core(msrv_soc_uncorewrapper_pass2_rtl_tessent_occ) {
  Scan {
    module_type                   : occ;
    allow_scan_out_retiming       : 0;
    supports_add_core_instances   : 1;
    is_hard_module                : 1;
    traceable                     : 1;
    pre_scan_drc_on_boundary_only : 0;
    ForcedDuringPreScanTracing {
      capture_en : 0;
      static_clock_control_mode : 0;
      shift_only_mode : 0;
    }
    Iproc(setup) {
      parameter_value_list : fast_capture_mode, 1;
    }
    Clock(slow_clock) {
      off_state : 1'b0;
    }
    ClockOut(tessent_persistent_cell_clock_out_mux/Z) {
      slow_clock_input : slow_clock;
      fast_clock_input : fast_clock;
    }
    FastCaptureClockEn(tessent_persistent_cell_cgc_fast_clock/E) {
      clock_input : fast_clock;
    }
    ShiftRegisterClockEn(occ_control/tessent_persistent_cell_cgc_SHIFT_REG_CLK/E) {
      clock_input : slow_clock;
    }
    ScanEn(scan_en) {
      active_polarity : 1'b1;
    }
    OccShiftOnlyEn(shift_only_mode) {
      active_polarity : 1'b1;
    }
    ScanChain {
      length         : 3;
      scan_in_port   : scan_in;
      scan_out_port  : scan_out;
      scan_in_clock  : slow_clock;
      scan_out_clock : ~slow_clock;
    }
  }
}
