proc tessent_scan_controller_chain_mode_mode {} {
   add_scan_groups grp1 ./scan_inserted_netlist/atpg_setup.testproc

   add_scan_chains controller_chain_mode_chain grp1 /ccm_scan_in0 /ccm_scan_out0

   tessent_scan_common

   add_pin_constraints msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/int_mode C0
   add_pin_constraints msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/controller_chain_mode C1
   add_pin_constraints msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/ext_mode C0
}


proc tessent_scan_ext_mode_mode {} {
   add_scan_groups grp1 ./scan_inserted_netlist/atpg_setup.testproc

   add_scan_chains ext_mode_chain0 grp1 {/ts_ext_mode_si[0]} {/ts_ext_mode_so[0]}
