   add_pin_constraints msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/controller_chain_mode C0
   add_pin_constraints msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/ext_mode C1
}


proc tessent_scan_setup { {mode int_mode} } {
   switch -exact -- $mode {
      int_mode { tessent_scan_int_mode_mode }
      controller_chain_mode { tessent_scan_controller_chain_mode_mode }
      ext_mode { tessent_scan_ext_mode_mode }
      default {
         display_message -error "invalid scan mode: $mode"
      }
   }
}


