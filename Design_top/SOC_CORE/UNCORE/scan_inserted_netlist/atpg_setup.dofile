proc tessent_scan_common {} {
   # internal input pin
   add_primary_inputs -internal msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/ltest_en
   add_clocks 0 test_clock_w
   add_clocks 0 ijtag_tck
   add_clocks 0 msrv_soc_uncorewrapper_pass2_rtl_tessent_occ_PCLK_inst/tessent_persistent_cell_clock_out_mux/Z  -internal -pin_name inferred_occ_clock0
   add_clocks 0 msrv_soc_uncorewrapper_pass2_rtl_tessent_occ_HCLK_inst/tessent_persistent_cell_clock_out_mux/Z  -internal -pin_name inferred_occ_clock1
   add_clocks 0 PCLK
   add_clocks 0 HCLK
   add_pin_constraints edt_update C0
   add_pin_constraints ijtag_sel C0
   add_pin_constraints ijtag_reset C1
   add_pin_constraints msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/ltest_en C1
add_black_boxes -auto
   // internal scan mode enables must be controllable
   add_primary_input -internal msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/int_mode
   add_primary_input -internal msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/controller_chain_mode
   add_primary_input -internal msrv_soc_uncorewrapper_pass2_rtl_tessent_tdr_sri_ctrl_inst/ext_mode
}


